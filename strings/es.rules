Parts
{
	TestCannonName = "Cañon de Testeo"
	TestCannonIcon = &TestCannonName
	TestCannonDesc = "Este es un cañon de testeo. Dispara lo que estemos probando hoy."

	IonBlasterName = "Cañon de Iones"
	IonBlasterIcon = &IonBlasterName
	IonBlasterDesc = "Dispara una ráfaga guiada de iones desde la torreta y luego dirige la ráfaga hacia su objetivo. Excelente para disparar en diagonal.\n\n"\
					"Al chocar, los iones estallan en un cono de energía que daña los componentes internos y provoca cortocircuitos, aturdiendo a la tripulación y provocando un incendio. Atraviesa el blindaje con facilidad, pero los escudos lo absorben por completo."
	IonBlasterOverclock = "Cañon de Iones Sobreacelerado"
	IonBlasterOverclockDesc = "Mejora el daño y hace que los iones exploten formando un cono de energía antes de colisionar, pero cause que la energía se fragmente mientras perfora y deje de perforar una vez que se agota su potencial de daño. Al dispararlo, se genera calor residual.""

	HeavyIonBlasterName = "Cañon de Iones Pesado"
	HeavyIonBlasterIcon = &HeavyIonBlasterName
	HeavyIonBlasterDesc = "Dispara una ráfaga masiva, pero lenta, de iones guiados desde la torreta y luego dirige la ráfaga hacia su objetivo. Excelente para disparar en diagonal.\n\n"\
						"Al chocar, los iones estallan en un cono de energía que daña los componentes internos y provoca cortocircuitos, aturdiendo a la tripulación y provocando un incendio. Atraviesa el blindaje con facilidad, pero los escudos lo absorben por completo."
	HeavyIonBlasterOverclock = "Cañon de Iones Pesado Sobreacelerado"
	HeavyIonBlasterOverclockDesc = "Mejora el daño y hace que los iones exploten formando un cono de energía antes de colisionar, pero cause que la energía se fragmente mientras perfora y deje de perforar una vez que se agota su potencial de daño. Al dispararlo, se genera calor residual.""

	GalvanicArmorName = "Armadura Galvánica"
	GalvanicArmorIcon = &GalvanicArmorName
	GalvanicArmorDesc = "Una placa ancha y blindada con dos bobinas cargadas en el exterior que electrocutarán a los enemigos y proyectiles cercanos, causando más daño a medida que se acerquen."
	GalvanicArmorOverclock = "Armadura Galvánica Sobrecalentada"
	GalvanicArmorOverclockDesc = "Mejora el alcance y el area de daño. Al dispararlo, se genera calor residual."

	ArcEmitterName = "Emisor de Arco"
	ArcEmitterIcon = &ArcEmitterName
	ArcEmitterDesc = "Una peligrosa bobina de Tesla que se monta en la parte superior de la nave en lugar de en el costado para lograr una mayor estabilidad. Cada emisor de arco requiere uno o más transformadores de arco adyacentes. Cuantos más transformadores de arcos, más rápido podrá disparar."
	ArcEmitterNameOverclock = "Emisor de Arco Sobrecalentado"
	ArcEmitterOverclockDesc = "El Emisor de Arco dispara más lento y drena toda la energía de arco disponible de los Transformadores de Arco adjacentes, pero su rango mejora, sus rayos se vuelven más grandes y aumentan su daño y duración en función de la energía de arco consumida. Al dispararlo, se genera calor residual."

	ArcTransformerName = "Transformador de Arco"
	ArcTransformerIcon = &ArcTransformerName
	ArcTransformerDesc = "Convierte las baterías en energía de arco para ser utilizada por Emisores de Arco y Armaduras Galvánicas."
	ArcTransformerNameOverclock = "Transformador de Arco Sobrecalentado"
	ArcTransformerOverclockDesc = "Triplica la capacidad energética y la capacidad de energía de arco. Al producir energía de arco, se genera calor residual."	

	// Armor / Ion Diffusion Lattice
	IonDiffusionLattice2x2 = "Difusor de Iones 2x2"
	IonDiffusionLattice2x2Icon = "Difusor de Iones 2x2"
	IonDiffusionLattice2x2Desc = "Contiene una disposición especial de reflectores de iones que actúan como un láser y una esponja al mismo tiempo. Absorben la energía de los iones y la expulsan en pequeños haces."
	IonDiffusionLatticeTechName = "Difusor de Iones"
	
	IonDiffusionLattice3x2 = "Difusor de Iones 3x2"
	IonDiffusionLattice3x2Icon = "Difusor de Iones 3x2"
	IonDiffusionLattice3x2Desc = &IonDiffusionLattice2x2Desc

	IonDiffusionLattice2x3Wedge = "Cuña de Difusor de Iones 2x3"
	IonDiffusionLattice2x3WedgeIcon = "Cuña de Difusor de Iones 2x3"
	IonDiffusionLattice2x3WedgeDesc = &IonDiffusionLattice2x2Desc

	IonDiffusionLattice2x4Wedge = "Cuña de Difusor de Iones 2x4"
	IonDiffusionLattice2x4WedgeIcon = "Cuña de Difusor de Iones 2x4"
	IonDiffusionLattice2x4WedgeDesc = &IonDiffusionLattice2x2Desc

	IonDiffusionLatticeWedge = "Cuña de Difusor de Iones"
	IonDiffusionLatticeWedgeIcon = "Cuña de Difusor de Iones"
	IonDiffusionLatticeWedgeDesc = &IonDiffusionLattice2x2Desc

	IonDiffusionLatticeTri = "Triangulo de Difusor de Iones"
	IonDiffusionLatticeTriIcon = "Triangulo de Difusor de Iones"
	IonDiffusionLatticeTriDesc = &IonDiffusionLattice2x2Desc
}

