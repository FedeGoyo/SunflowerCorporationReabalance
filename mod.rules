		Overrides = &<parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/Components"
		Overrides = &<parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Components
	}
	{
