ID = fariel.sunflowercorp.enderluck
Name = "Sunflower Corporation Rebalance"
Version = 1.0.2
CompatibleGameVersions = ["0.23.3", "0.30.3"]
ModifiesMultiplayer = true
Author = "Enderluck"
Logo = "logo.png"
StringsFolder = "strings"

Description = "This mod rebalances Fariel's Sunflower Corporation mod and therefore requires that mod to work."

Actions
[
// Add new stuff
	{
		Action = Overrides
		CreateIfNotExisting = true
		OverrideIn = "<buffs/buffs.rules>" 
		Overrides = &<buffs/buffs.rules>	// Add Buffs
	}
	{
		Action = AddMany
		AddTo = "<gui/game/parts/part_stats.rules>/PartStats"
		ManyToAdd = &<stats/stats.rules>/Stats
	}
	
// Rebalance Arc Emitter
	// Start adding base for Overclock
	{
		Action = RemoveMany
		RemoveMany = 
		[
			<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/SalvagedEffects
			<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ConstructionStructureSprites
			<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ConstructionProgressSprites
			<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ConstructionProgressAnimationSprites
		]
	}
	{
		Action = AddBase
		AddBaseTo = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part"
		BaseToAdd = &<./Data/ships/terran/base_med_part_terran_overclock.rules>/Part
	}
	{
		Action = AddBase
		AddBaseTo = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components"
		BaseToAdd = &<./Data/ships/terran/base_med_part_terran_overclock.rules>/Part/Components
	}
	{
		Action = AddMany
		AddTo = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/ReceivableBuffs"
		ManyToAdd = &<parts/arc_emitter/arc_emitter.rules>/ReceivableBuffs
	}
	// End adding base for Overclock
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part"
		Overrides = &<parts/arc_emitter/arc_emitter.rules>/Part
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components"
		Overrides = &<parts/arc_emitter/arc_emitter.rules>/Components
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/Weapon"
		Overrides = &<parts/arc_emitter/arc_emitter.rules>/Weapon
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter"
		Overrides = &<parts/arc_emitter/arc_emitter.rules>/ArcEmitter
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitterStorageProxy"
		Overrides = &<parts/arc_emitter/arc_emitter.rules>/ArcEmitterStorageProxy
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/Indicators/Indicators"
		With = &<parts/arc_emitter/arc_emitter.rules>/Indicators
	}
/*	Used to make it only shot at full capacity. Requires to also activate some things in arc_emitter.rules and arc_transformer.rules
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/Weapon/OperationalToggle"
		With = ReadyToShot	// Make it only shot when at full capacity
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitterStorageProxy/ProvidedValuePerResource"
		With = 1/1000	// Reduce arc energy storage value. Used for scaling damage when shot at full capacity
	}
*/
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Stats"
		Overrides = &<parts/arc_emitter/arc_emitter.rules>/Stats
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats"
		Overrides = &<parts/arc_emitter/arc_emitter.rules>/StatsArcBeam
	}
	// Modify shot
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/shots/lightning_bolt/lightning_bolt.rules>"
		Overrides = &<shots/lightning_bolt/lightning_bolt.rules>/Base	// Modify range when overclocked
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/lightning_bolt/lightning_bolt.rules>/HitNothing/HitEffects"
		With = &<shots/lightning_bolt/lightning_bolt.rules>/HitEffects	// Replace normal damage with explosive damage, reduce damage, add fire chance and ElectronBuff
	}
	// Remove stuff
	{
		Action = RemoveMany
		RemoveMany = 
		[
			// Unused Stats
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats/DamagePerShot"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats/DamagePerSecond"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats/Damage"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats/BaseDamage"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats/ROF"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats/Duration"
			// To add targeting
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/FireModeToggle/AvailableChoices"
			// Fix beam graphic
			"<../../../workshop/content/799600/2995534359/shots/lightning_bolt/lightning_bolt.rules>/BeamMediaEffects/0/MinIntensity"
			"<../../../workshop/content/799600/2995534359/shots/lightning_bolt/lightning_bolt.rules>/BeamMediaEffects/1/MinIntensity"
			// Unused Components
//			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/EffectsScaleFactor"
			<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitterStorageProxy/AddMode
			<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/Weapon/AllowRotationToggle
			<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/ValueScaleFactor
			<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/ResourceScaleFactor
			<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/TurnTimer
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggle1"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggler1"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggle2"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggler2"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggle3"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggler3"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggle4"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggler4"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggle5"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggler5"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggle6"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggler6"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggle7"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggler7"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggle8"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggler8"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggle9"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggler9"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggle10"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggler10"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggle11"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggler11"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggle12"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ThresholdToggler12"
		]
	}

// Rebalance Arc Transformer
	{
		Action = AddMany
		AddTo = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/ReceivableBuffs"
		ManyToAdd = &<parts/arc_transformer/arc_transformer.rules>/ReceivableBuffs
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part"
		Overrides = &<parts/arc_transformer/arc_transformer.rules>/Part
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components"
		Overrides = &<parts/arc_transformer/arc_transformer.rules>/Components
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/TransformerArcEnergyStorage/MaxResources"
		With = &<parts/arc_transformer/arc_transformer.rules>/TransformerArcEnergyStorage_MaxResources
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/BatteryStorage/MaxResources"
		With = &<parts/arc_transformer/arc_transformer.rules>/BatteryStorage_MaxResources
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/BatteryConsumer/Storage"
		With = &<parts/arc_transformer/arc_transformer.rules>/BatteryConsumer_Storage
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/Indicators/Indicators"
		With = &<parts/arc_transformer/arc_transformer.rules>/Indicators
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Stats"
		Overrides = &<parts/arc_transformer/arc_transformer.rules>/Stats
	}
	// Remove stuff
	{
		Action = RemoveMany
		RemoveMany = 
		[
			// Unused Components
//			"<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/TransformerArcEnergyStorage/ProvidedValueRange"
//			"<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/TransformerArcEnergyStorage/ProvidedValuePerResource"
			"<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/BatterySprites"
			"<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/ArcEnergySprites"
			// Unused stats
//			"<../../../workshop/content/799600/2995534359/stats/stats.rules>/Stats/2"	// Gives error if I try to remove them
//			"<../../../workshop/content/799600/2995534359/stats/stats.rules>/Stats/1"	// Gives error if I try to remove them
			"<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Stats/ArcEnergyConversionRate"
			"<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Stats/ArcEnergyConversionTime"
		]
	}

// Rebalance Galvanic Armor
	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/ReceivableBuffs"
		ToAdd = ElectronBuff	// Adds ElectronBuff
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part"
		Overrides = &<parts/galvanic_armor/galvanic_armor.rules>/Part
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components"
		Overrides = &<parts/galvanic_armor/galvanic_armor.rules>/Components
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/TurretProxy"
		Overrides = &<parts/galvanic_armor/galvanic_armor.rules>/TurretProxy
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/FireTimer/Duration"
		With = 1/30	// Increase fire rate
	}
	{
		Action = AddBase
		AddBaseTo = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft"
		BaseToAdd = &<shots/galvanic_bolt/galvanic_bolt.rules>	// Add shield damage, required for beam
	}
	{
		Action = AddBase
		AddBaseTo = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterRight"
		BaseToAdd = &<shots/galvanic_bolt/galvanic_bolt.rules>	// Add shield damage, required for beam
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft"
		Overrides = &<parts/galvanic_armor/galvanic_armor.rules>/BulletEmitter	// Replace bullet with beam and reduce resource used
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterRight"
		Overrides = &<parts/galvanic_armor/galvanic_armor.rules>/BulletEmitter	// Replace bullet with beam and reduce resource used
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats"
		Overrides = &<parts/galvanic_armor/galvanic_armor.rules>/Stats
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Stats/RecPower"
		With = (&<./Data/../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/PowerUsageContinuous)
	}
	// Remove stuff
	{
		Action = RemoveMany
		RemoveMany = 
		[
			// To add targeting
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/FireModeToggle/AvailableChoices"
			// No longer uses bullet
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft/Bullet"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterRight/Bullet"
			// No longer can use Arc Energy
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BuffProvider"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/ArcEmitterStorageProxy"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/ConvertFromArcEnergyToBatter"
			// Unused stats and pre-standarized stats
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/HitInterval"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/DamagePerShotNear"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/DamagePerShotFar"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/ShotDamage"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/ShotPowerUsage"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/PowerPerSecond"

		]
	}

// Rebalance Heavy Ion Blaster
	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/ReceivableBuffs"
		ToAdd = ElectronBuff	// Adds ElectronBuff
	}
	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>"
		Name = ReceivableBuffs
		ToAdd = [ElectronBuff]	// Adds ElectronBuff, not sure if needed as it does nothing here, but the spawned bullets do
	}
	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/ion_scatter_ray.rules>"
		Name = ReceivableBuffs
		ToAdd = [ElectronBuff]	// Adds ElectronBuff
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/Resources"
		With = &<parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Resources	// Reduce cost
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/Components/BulletEmitter"
		Overrides = &<parts/heavy_ion_blaster/heavy_ion_blaster.rules>/BulletEmitter	// Reduce resource used and reduce minimum resource use
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/Components/Turret"
		Overrides = &<parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Turret	// Increase firing arc
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/Components/Targetable/Health"
		With = 3000	// Reduce projectile HP
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/Components/Hit/HitStructural/HitEffects/1/Impulse"
		With = 25	// Reduce impact
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/Components/Turret/FireInterval"
		With = 2.5	// Reduce fire interval (speed up)
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/Components/Hit/HitOperational/HitEffects/2/Arc"
		With = [-60d, 120d]	// Fix and increase arc spawn of scatter
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/ion_scatter_ray.rules>/Components/DeployDeath/Lifetime"
		With = [0.4, 1.2]	// Reduce projectile scatter lifetime
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/ion_scatter_ray.rules>/Components/Hit"
		With = &<shots/heavy_ion_blaster/ion_scatter_ray.rules>/Hit	// Added penetration, reduced damage and impulse, added effect on HitShield, add ElectronBuff
	}
	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/StatsByCategory/0/Stats"
		Name = Scatter	// New stat
		ToAdd = ("&<./Data/../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/Components/Hit/HitOperational/HitEffects/1/Count")
	}
	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/StatsByCategory"
		ToAdd = &<parts/heavy_ion_blaster/heavy_ion_blaster.rules>/StatsByCategory	// Add stats
	}
	{
		Action = RemoveMany
		RemoveMany
		[
			"<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/InitialPenetrationResistance"	// No longer penetration resistance
			// Damage
			"<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/Components/Hit/HitOperational/HitEffects/0"
			"<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/Components/Hit/HitStructural/HitEffects/0"
			// Ion Burst
			"<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/ion_scatter_ray.rules>/Components/DeployDeath/OnDeath"
			// Unused stats
			"<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/StatsByCategory/0/Stats/DamagePerShot"
			"<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/StatsByCategory/0/Stats/DamagePerSecond"
			"<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/StatsByCategory/0/Stats/Damage"
		]
	}

// Rebalance Ion Blaster
	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/ReceivableBuffs"
		ToAdd = ElectronBuff	// Adds ElectronBuff
	}
	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/shots/ion_blaster/ion_blaster_shot.rules>"
		Name = ReceivableBuffs
		ToAdd = [ElectronBuff]	// Adds ElectronBuff, not sure if needed as it does nothing here, but the spawned bullets do
	}
	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/Components/TurretCollider"
		Name = InitialPenetrationResistance
		ToAdd = 5	// Add penetration resistance to the turret
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/Components/Turret/FireInterval"
		With = 2	// Increase fire interval (slow down)
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/Components/BulletEmitter/ResourcesUsed"
		With = 1333	// Increased resource used
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/Components/Turret"
		Overrides = &<parts/ion_blaster/ion_blaster.rules>/Turret	// Increase firing arc
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/ion_blaster/ion_blaster_shot.rules>/Range"
		With = 300	// Increase range
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/ion_blaster/ion_blaster_shot.rules>/IdealRange"
		With = [200, 300]	// Increase range
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/ion_blaster/ion_blaster_shot.rules>/Components/Hit/HitOperational/HitEffects/1/Impulse"
		With = 16	// Increase impulse
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/ion_blaster/ion_blaster_shot.rules>/Components/Hit/HitStructural/HitEffects/1/Impulse"
		With = 8	// Increase impulse
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/ion_blaster/ion_blaster_shot.rules>/Components/Physics/Radius"
		With = 0.1	// Increase size
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/ion_blaster/ion_blaster_shot.rules>/Components/Targetable/Health"
		With = 600	// Increase projectile HP
	}
	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/shots/ion_blaster/ion_blaster_shot.rules>/Components/Hit/HitOperational/HitEffects"
		ToAdd =	&<shots/ion_blaster/ion_blaster_shot.rules>/HitEffects/0	// Add scatter
	}
/*	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/StatsByCategory/0/Stats"
		Name = Scatter	// New stat
		Override = ("&<./Data/../../../workshop/content/799600/2995534359/shots/ion_blaster/ion_blaster_shot.rules>/Components/Hit/HitOperational/HitEffects/1/Count")
