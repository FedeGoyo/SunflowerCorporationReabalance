	}
	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/StatsByCategory"
		ToAdd = &<parts/heavy_ion_blaster/heavy_ion_blaster.rules>/StatsByCategory
	}
	// Modify shot
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>"
		Overrides = &<shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/Base
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/ion_scatter_ray.rules>"
		Overrides = &<shots/heavy_ion_blaster/ion_scatter_ray.rules>/Base
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/Components/Targetable/Health"
		With = &<shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/Targetable_Health
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/Components/Hit/HitStructural/HitEffects/1/Impulse"
		With = &<shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/HitStructural_Impulse
	}
	{
