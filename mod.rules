		ToAdd = &<parts/ion_blaster/ion_blaster.rules>/IonBlasterScatterStats	// Add stats
	}
	{
		Action = RemoveMany
		RemoveMany
		[
			"<../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/InitialPenetrationResistance"	// No longer penetration resistance
			// Damage
			"<../../../workshop/content/799600/2995534359/shots/ion_blaster/ion_blaster_shot.rules>/Components/Hit/HitOperational/HitEffects/0"
			"<../../../workshop/content/799600/2995534359/shots/ion_blaster/ion_blaster_shot.rules>/Components/Hit/HitStructural/HitEffects/0"
			// Unused stats
			"<../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/StatsByCategory/0/Stats/DamagePerShot"
			"<../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/StatsByCategory/0/Stats/DamagePerSecond"
			"<../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/StatsByCategory/0/Stats/Damage"
		]
	}

// Rebalance Cluster Missile
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/missile_cluster/missile_cluster_stage1.rules>/Components/Targetable/Health"
		With = 4800	// Reduce base hp
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/shots/missile_cluster/missile_cluster_stage1.rules>/Components/Hit/HitOperational/HitEffects/0"
		Overrides = &<shots/missile_cluster/missile_cluster_stage1.rules>/HitEffects/0
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/missile_cluster/missile_cluster_stage1.rules>/Components/Hit/HitOperational/HitEffects/1/Impulse"
		With = 180	// Increase impulse
	}
	{
		Action = Replace
		Replace = "&<../../../workshop/content/799600/2995534359/shots/missile_cluster/missile_cluster_stage2.rules>/Components/Targetable/OnDeath"
		With = "&<./Data/../../../workshop/content/799600/2995534359/shots/missile_cluster/missile_cluster_stage1.rules>/Components/Hit/HitFriendly"	// Prevent crashing due to the Hit change
	}
	{
		Action = Replace
		Replace = "&<../../../workshop/content/799600/2995534359/shots/missile_cluster/missile_cluster_stage2.rules>/Components/Hit"
		With = &<shots/missile_cluster/missile_cluster_stage2.rules>/Components/Hit
	}

