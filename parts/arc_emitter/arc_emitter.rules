//	DamageArcNearPerShot = (&DamagePerShot) * (&NearScale)
//	DamageArcNearPerSecond = (&DamagePerSecond) * (&NearScale)
//	DamageArcNear = [&../DamageArcNearPerShot, &../DamageArcNearPerSecond]
//	DamageArcFarPerShot = (&DamagePerShot) * (&FarScale)
//	DamageArcFarPerSecond = (&DamagePerSecond) * (&FarScale)
//	DamageArcFar = [&../DamageArcFarPerShot, &../DamageArcFarPerSecond]
//	FireChance = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/HitNothing/HitEffects/1/FireChance) // (&<./Data/../../../workshop/content/799600/2995534359/shots/lightning_bolt/lightning_bolt.rules>/HitNothing/HitEffects/1/FireChance) * 100


	LightningRange = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/HitNothing/HitEffects/0/InitialRadius)
	LightningMaxChain = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/HitNothing/HitEffects/0/MaxChainLength/1)
	LightningChainStrikeCountRange = [(&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/HitNothing/HitEffects/0/ChainStrikes/0), (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/HitNothing/HitEffects/0/ChainStrikes/1)]
