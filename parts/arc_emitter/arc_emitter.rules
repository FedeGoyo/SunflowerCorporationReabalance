Weapon
{
	FireInterval = 5/6	// To use Arc Transformers when shooting only at full capacity, set this to 0
	CanBeGivenExplicitTarget = true	// Add targeting
	AllowDirectControl = true	// Add targeting

	AutoTargets	// Add targeting
	[
		{
			TargetType = ShipParts
			Toggle = AutoTargetToggle
		}
	]
}
ArcEmitter
{
	ResourcesUsed = 4000	// Reduce resource used
	MinResourcesUsed = 4000	// Reduce minimum resource used
	Duration = 5/6
}
Stats	// New stats
{
	RecCrew = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/PartCrew/Crew)
