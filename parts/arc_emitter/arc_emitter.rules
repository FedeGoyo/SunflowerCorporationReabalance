OVERCLOCK
{
	HEAT_PER_ARC = 1000
	HEAT_PER_SHOT = (&HEAT_PER_ARC) / 1000 / (&~/ArcEmitterStorageProxy/ProvidedValuePerResource)

	MIN_ARC_ENERGY_FACTOR = 12000 / 4000
	ARC_ENERGY = infinity
	FIRE_INTERVAL = 9
	FIRE_INTERVAL_FACTOR = (&FIRE_INTERVAL) / (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/Weapon/FireInterval/BaseValue)
}

HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

ReceivableBuffs : &<./Data/ships/base_part_overclock.rules>/Part/ReceivableBuffs [ElectronBuff, Arc_Energy, Arc_Energy_Heat_Multiplier, Arc_Emitter_Capacity]	// Add Buffs

Part
{
	Resources // Reduce cost
	[
		[steel, 44]
		[coil2, 38]
		[processor, 5]
	]
	
	StatsNotesKey = "Stats/ArcNotes"	// Add stats note
	
	SecondaryToolTip	// Add overclock stats
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/ArcEmitterOverclockDesc"
		StatsByCategory
		[
			{
				NameKey = "StatCategories/ArcBeamOverclock"
				Stats
				{
					HeatPerShotPerArc = (&~/OVERCLOCK/HEAT_PER_ARC)
					ArcDurationHits = [ &~/ArcEmitter/Duration/BaseValue, 1 / (&~/StatsArcBeam/HitInterval)]
					ROF = 1 / ((&~/Weapon/FireInterval/BaseValue) * (&~/OVERCLOCK/FIRE_INTERVAL_FACTOR))
					ArcEnergyShot = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/ResourcesUsed/BaseValue) * (&~/OVERCLOCK/MIN_ARC_ENERGY_FACTOR) / 1000
					ArcEnergyPerSecond = (&ArcEnergyShot) * (&ROF)
					ArcEnergyUsedRange = [&../ArcEnergyShot, &~/OVERCLOCK/ARC_ENERGY, &../ArcEnergyPerSecond, &~/OVERCLOCK/ARC_ENERGY]
					LightningRange = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/HitNothing/HitEffects/0/InitialRadius/BaseValue) * (&<../../shots/lightning_bolt/lightning_bolt.rules>/OVERCLOCK/RADIUS_FACTOR)
					LightningMaxChain = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/HitNothing/HitEffects/0/MaxChainLength/1/BaseValue) + (&<../../shots/lightning_bolt/lightning_bolt.rules>/OVERCLOCK/MAX_CHAIN_LENGTH_BONUS)				
					ArcLightningDamage = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/HitNothing/HitEffects/0/HitEffects/0/Damage/BaseValue)
					ArcAmplification = 1 / (&~/ArcEmitterStorageProxy/ProvidedValuePerResource) / 1000
					Range = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/Range/BaseValue) * (&<../../shots/lightning_bolt/lightning_bolt.rules>/OVERCLOCK/RANGE_FACTOR)
				}
			}
		]
		StatsNotesKey = "Stats/ArcOverclockNotes"
	}
}

Components
{
	IsOperational	// Shall I add Arc Energy as a requisite as if it were BatteryStorage?
	{
		Type = MultiToggle
		Toggles = [PowerToggle, PartCrew, ScorchedToggle, &<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/OVERCLOCK_OPERATIONAL]
		Mode = All
	}

	CommandConsumptionToggle
	{
		Type = MultiToggle
		Toggles = [PowerToggle, ScorchedToggle]
		Mode = All
	}
	
	ScorchedToggle
	{
		Type = StatusToggle
		StatusType = cosmoteer.scorched
		MinStatusValue = 1
		Invert = true
	}

	CommandConsumer
	{
		Type = CommandConsumer
		OperationalToggle = CommandConsumptionToggle
		CommandPoints = 5
	}
	
	ArcEmitterCapacityBuffToggle	// For Missing Component Indicator
	{
		Type = BuffToggle
		BuffType = Arc_Emitter_Capacity
	}

	OverclockStateValue
	{
		Type = ToggleValueSelector
		Toggle = OverclockModeToggle
		ToggleOffValue = Zero
		ToggleOnValue = One
	}

	Zero { Type = StaticValue; Value = 0; }
	One { Type = StaticValue; Value = 1; }

	Overclock_ArcEmitter
	{
		Type = TriggerProxy
		ComponentID = ArcEmitter
		ProxyToggle = IsOverclocked
	}

	Overclock_ShotHeatProducer
	{
		Type = ResourceChange
		ResourceStorage = HeatDistributionStorage
		Trigger = Overclock_ArcEmitter
		Amount
		{
			BaseValue = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/HEAT_TO_RESOURCE)
			Modifiers
			[
				{
					Type = Buff
					BuffType = Arc_Energy_Heat_Multiplier
					ModificationMode = Multiply
				}
			]
		}
	}
	
	ArcHeatCollectionStorage
	{
		Type = ResourceStorageProxy
		ResourceType = heat
		ComponentID = HeatDistributionStorage
	}

	Overclock_HeatCollectionBuffProvider
	{
		Type = GridBuffProvider
		BuffType = ArcHeatCollector
		GridDistance = 1
		OperationalToggle = IsOperationalOverclocked
	}

	Port_Thermal_Left : <./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/BASE_THERMAL_PORT
	{
		Location = [0, 1]
		Direction = Left
	}
	Port_Thermal_Up : Port_Thermal_Left
	{
		Location = [1, 0]
		Direction = Up
	}
	Port_Thermal_Right : Port_Thermal_Left
	{
		Location = [2, 1]
		Direction = Right
	}
	Port_Thermal_Down : Port_Thermal_Left
	{
		Location = [1, 2]
		Direction = Down
	}
	
	ScorchedTrigger
	{
		Type = ToggleTrigger
		Toggle = ScorchedToggle
		TriggerWhenOn = false
	}

	ScorchedEffects
	{
		Type = TriggeredEffects
		Trigger = ScorchedTrigger
		Location = &<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/DestroyedEffects/Location
		MediaEffects = &/COMMON_EFFECTS/BigPartScorched
	}

	PeakHeatGenerationValue
	{
		Type = StaticValue
		SHOT_HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/Part/SecondaryToolTip/StatsByCategory/0/Stats/ROF)
		Value = (&SHOT_HEAT_PER_SECOND)
	}
	HeatGenerationStatProvider
	{
		Type = StatProvider
		Stat = HeatGeneration
		OperationalToggle = OverclockModeToggle
		ValueFrom = PeakHeatGenerationValue
	}
	
	AutoTargetToggle // Add targeting
	{
		Type = ModeToggle
		Mode = FireModeToggle
		OnModes = [1, 2]
	}

/*	Currently not used, requires to first enable NotReadyToggle in arc_transformer.rules
	Canshot	// Prevent it from shooting if at least one of the active adjacent arc transformers isn't at full arc energy capacity
	{
		Type = MultiToggle
		ViaBuffs
		{
			OutgoingBuffProviders = [BuffProvider]
			ComponentID = NotReadyToggle
		}
		Mode = Any
		Invert = true
	}
	ReadyToShot
	{
		Type = MultiToggle
		Toggles = [OperationalWithPower, CanShot]
		Mode = All
	}
*/
	ReloadProgressBar
	{
		Type = ProgressBar
		OperationalToggle = IsOperational
		ShowProgressFor = Weapon // ArcEmitterStorageProxy
	}
	
	DelayWeapon
	{
		Type = DelayTrigger
		Trigger = Weapon
		Delay = &~/ArcEmitter/Duration //(&~/ArcEmitter/Duration/BaseValue) * (&~/OVERCLOCK/DURATION_FACTOR)
	}
	
	ArcEmitterStorageBuff
	{
		Type = SelfBuffProvider
		BuffType = Arc_Energy
		BuffAmount = 1
		BuffMultiplier = ArcEmitterStorageProxy
	}
	
	UpdateTrigger
	{
		Type = Timer
		Duration = 1/30
		AutoStart = true
		Repeats = true
	}
	
	StoredArcEnergy
	{
		Type = ValueAccumulator
		OperationalToggle = ArcEmitter
		InvertOperationalToggle = true
		AccumulationTriggers
		[
			{
				Trigger = UpdateTrigger
				Operation = 2
				Value = {BaseValue = 1, BuffType = Arc_Energy, BuffMode = Multiply}
				AllowWhenNonOperational = false
			}
			{
				Trigger = DelayWeapon
				Operation = 2
				Value = 0
			}
		]
	}
	
	BuffProvider_Heat
	{
		Type = SelfBuffProvider
		OperationalToggle = IsOperationalOverclocked
		BuffType = Arc_Energy_Heat_Multiplier
		BuffAmount = 1
		BuffMultiplier = StoredArcEnergy
	}
	
	BuffProvider_Shot
	{
		Type = SelfBuffProvider
		OperationalToggle = IsOperationalOverclocked
		BuffType = Arc_Emitter_Shot
		BuffAmount = 1
		BuffMultiplier = StoredArcEnergy
	}
}

ArcEmitterStorageProxy
{
	RemoveMode = DistributeProportionallyByAvailable	// So that they can all start to reload
	ProvidedValuePerResource = 1/12000	// Reduce value, only used when overclocked
	ViaBuffs
	{
		OutgoingBuffProviders = [BuffProvider]
		ComponentID = Combined_TransformerArcEnergyStorage
	}
}
Weapon
{
	FireInterval // To use Arc Transformers when shooting only at full capacity, set this to 0
	{
		BaseValue = 1	// Reduce fire interval
		Modifiers
		[
			{
				Type = BuffRemap
				BuffType = Overclock
				ModificationMode = Multiply
				RemapFrom = [0, 1]
				RemapTo = [1, (&~/OVERCLOCK/FIRE_INTERVAL_FACTOR)]
			}
		]
	}
	CanBeGivenExplicitTarget = true	// Add targeting
	AllowDirectControl = true	// Add targeting

	AutoTargets	// Add targeting
	[
		{
			TargetType = ShipParts
			Toggle = AutoTargetToggle
		}
	]
}

ArcEmitter
{
	ResourcesUsed	// Reduce resource used
	{
		BaseValue = 4000	// Reduce energy used
		Modifiers
		[
			{
				Type = BuffRemap
				BuffType = Overclock
				ModificationMode = Multiply
				RemapFrom = [0, 1]
				RemapTo = [1, &~/OVERCLOCK/ARC_ENERGY]
			}
		]
	}
	MinResourcesUsed	// Reduce minimum resource used
	{
		BaseValue = 4000	// Increase energy used
		Modifiers
		[
			{
				Type = BuffRemap
				BuffType = Overclock
				ModificationMode = Multiply
				RemapFrom = [0, 1]
				RemapTo = [1, &~/OVERCLOCK/MIN_ARC_ENERGY_FACTOR]
			}
		]
	}
	Duration
	{
		BaseValue = 1	// Increase duration
		Modifiers
		[
			{
				Type = Buff
				BuffType = Arc_Emitter_Shot	// Only when Overclocked
				ModificationMode = Multiply
			}
		]
	}
}
Indicators	// Add indicators
[
	// Scorched
	{
		Toggle = ScorchedToggle
		AtlasSprite = &/INDICATORS/Scorched
		HidesIndicators = [1,2,3,4,5]
	}
	// Missing component
	{
		Toggle = ArcEmitterCapacityBuffToggle
		ShowInBuildMode = true
		AtlasSprite
		{
			File = &/INDICATORS/MissingComponent
			Size = [1, 1]
		}
	}
	// Turned off.
	{
		Toggle = PowerToggle
		AtlasSprite
		{
			File = &/INDICATORS/PowerOff
			Size = [1, 1]
		}
		HidesIndicators = [3,4,5]
	}

	// Out of power.
	{
		Toggle = ArcEmitterStorageProxy
		Delay = &<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/Weapon/FireInterval/BaseValue
		AtlasSprite
		{
			File = "./Data/../../../workshop/content/799600/2995534359/buffs/arc_energy_red.png"
			Size = [1, 1]
		}
	}

	// Resetting from overclock
	{
		Toggle = &<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/OVERCLOCK_OPERATIONAL
		AtlasSprite : /INDICATORS/OverclockReset
		{
			Size = [1, 1]
		}
		HidesIndicators = [5]
	}
				
	// No crew.
	{
		Toggle = PartCrew
		AtlasSprite
		{
			File = &/INDICATORS/NoCrew
			Size = [1, 1]
		}
	}
]
Stats	// New stats
{
	RecCrew = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/PartCrew/Crew)
}
StatsArcBeam	// New stats
{
	// Not modified
	HitInterval = (&<./Data/../../../workshop/content/799600/2995534359/shots/lightning_bolt/lightning_bolt.rules>/HitInterval)
	// New
	RELOAD = (&~/ArcEmitter/MinResourcesUsed/BaseValue) / 1000 / (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Stats/ArcEnergyGeneration)
	ROF_MIN = 1 / (&RELOAD)
	ROF_MAX = 1 / (&~/Weapon/FireInterval/BaseValue)
	ArcROFRange = [ &../ROF_MIN, &../ROF_MAX]
	ARC_ENERGY_SHOT = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/ResourcesUsed/BaseValue) / 1000
	ARC_ENERGY_PER_SECOND_MIN = (&ARC_ENERGY_SHOT) * (&ROF_MIN)
	ARC_ENERGY_PER_SECOND_MAX = (&ARC_ENERGY_SHOT) * (&ROF_MAX)
	ArcEnergyUsedScaled = [&../ARC_ENERGY_SHOT, &../ARC_ENERGY_PER_SECOND_MIN , &../ARC_ENERGY_PER_SECOND_MAX]
	DurationHits = [ &~/ArcEmitter/Duration/BaseValue, 1 / (&../HitInterval)]
	LightningRange = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/HitNothing/HitEffects/0/InitialRadius/BaseValue)
	LightningMaxChain = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/HitNothing/HitEffects/0/MaxChainLength/1/BaseValue)
	LightningChainStrikeCountRange = [(&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/HitNothing/HitEffects/0/ChainStrikes/0), (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/HitNothing/HitEffects/0/ChainStrikes/1)]
	LightningDamage = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/HitNothing/HitEffects/0/HitEffects/0/Damage/BaseValue)
	Range = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/Range/BaseValue)
}