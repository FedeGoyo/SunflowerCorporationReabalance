OVERCLOCK
{
	HEAT_PER_SHOT = 10
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

ReceivableBuffs : &<./Data/ships/base_part_overclock.rules>/Part/ReceivableBuffs [ElectronBuff]	// Add Buffs

Part
{
	Resources	// Reduce cost
	[
		[steel, 24]
		[coil2, 8]
		[tristeel, 10]
	]
	InitialPenetrationResistance = 5	// Reduce penetration resistance
	ExplosiveDamageResistance = 50%	// Increase explosive resistance

	SecondaryToolTip	// Add overclock stats
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/GalvanicArmorOverclockDesc"
		StatsByCategory
		[
			{
				NameKey = "StatCategories/GalvanicBoltOverlock"
				Stats
				{
					ROF = &~/Stats/ROF
					HeatGeneration = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&ROF)
					Range = (&<./Data/../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft/Range/BaseValue) * (&<./Data/../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft/OVERCLOCK/RADIUS_FACTOR)
					DamageArea = (&<./Data/../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft/HitNothing/HitEffects/1/Radius/BaseValue) * (&<./Data/../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft/OVERCLOCK/RADIUS_FACTOR)
				}
			}
		]
	}
}

Components
{
	IsOperational
	{
		Type = MultiToggle
		Toggles = [PowerToggle, BatteryStorage, PartCrew, ScorchedToggle, &<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/OVERCLOCK_OPERATIONAL]
		Mode = All
	}

	CommandConsumptionToggle
	{
		Type = MultiToggle
		Toggles = [PowerToggle, ScorchedToggle]
		Mode = All
	}
	
	ScorchedToggle
	{
		Type = StatusToggle
		StatusType = cosmoteer.scorched
		MinStatusValue = 1
		Invert = true
	}

	CommandConsumer
	{
		Type = CommandConsumer
		OperationalToggle = CommandConsumptionToggle
		CommandPoints = 5
	}
	
	// Add preferred fire
	FirePrefToggle
	{
		Type = UIToggle
		ToggleID = "fire_pref"
		Default = 2
	}
	FirePrefAttack
	{
		Type = ModeToggle
		Mode = FirePrefToggle
		OnModes = [0, 2]
	}
	FirePrefDefend
	{
		Type = ModeToggle
		Mode = FirePrefToggle
		OnModes = [1, 2]
	}
	AttackToggle
	{
		Type = MultiToggle
		Toggles = [AutoTargetToggle, FirePrefAttack]
		Mode = All
	}
	DefendToggle
	{
		Type = MultiToggle
		Toggles = [AutoTargetToggle, FirePrefDefend]
		Mode = All
	}
	
	BulletEmitterLeft :	&<../../shots/galvanic_bolt/galvanic_bolt.rules>	// Uses this name to replace the original
	{
		Type = BeamEmitter	// Replace bullet with beam
		FireTrigger = ShootLeftTrigger
		ChainedTo = TurretLeft
		GetTargetFrom = TurretLeft
		Location = [0, 0]
		OperationalToggle = IsOperational
		FireDelay = 0
		ResourceStorage = BatteryStorage
		ResourcesUsed = 60	// Reduce resource used
		MinResourcesUsed = 1
	}
	BulletEmitterRight :	BulletEmitterLeft	// Uses this name to replace the original
	{
		FireTrigger = ShootRightTrigger
		ChainedTo = TurretRight
		GetTargetFrom = TurretRight
	}
	
	// Add Overclocked
	OverclockStateValue
	{
		Type = ToggleValueSelector
		Toggle = OverclockModeToggle
		ToggleOffValue = Zero
		ToggleOnValue = One
	}

	Zero { Type = StaticValue; Value = 0; }
	One { Type = StaticValue; Value = 1; }

	Overclock_BeamEmitter
	{
		Type = MultiTrigger
		Triggers = [BulletEmitterLeft, BulletEmitterRight]
		OperationalToggle = IsOperationalOverclocked
	}

	Overclock_ShotHeatProducer
	{
		Type = ResourceChange
		ResourceStorage = HeatDistributionStorage
		Trigger = Overclock_BeamEmitter
		Amount = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/HEAT_TO_RESOURCE)
	}
	
	Port_Thermal_DownLeft : <./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/BASE_THERMAL_PORT
	{
		Location = [0, 1]
		Direction = Down
	}
	Port_Thermal_DownRight : Port_Thermal_DownLeft	{ Location = [2, 1] }
	
	ScorchedTrigger
	{
		Type = ToggleTrigger
		Toggle = ScorchedToggle
		TriggerWhenOn = false
	}

	ScorchedEffects
	{
		Type = TriggeredEffects
		Trigger = ScorchedTrigger
		Location = &<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/DestroyedEffects/Location
		MediaEffects = &/COMMON_EFFECTS/BigPartScorched
	}

	PeakHeatGenerationValue
	{
		Type = StaticValue
		SHOT_HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/Stats/ROF)
		Value = (&SHOT_HEAT_PER_SECOND)
	}
	HeatGenerationStatProvider
	{
		Type = StatProvider
		Stat = HeatGeneration
		OperationalToggle = OverclockModeToggle
		ValueFrom = PeakHeatGenerationValue
	}
}

TurretProxy	// Add targeting
{
	AllowShipWideExplicitTargetsToggle = FirePrefAttack
	EstimateFirepowerToggle = AttackToggle
	AlwaysShowCoverage = true
	AllowDirectControlToggle = FirePrefAttack
	FirePermissionToggle = FireModeToggle
	CanBeGivenExplicitTarget = true
	TargetSearchesPerSecond = 15	// Increase searchs per second
	
	AutoTargets
	[
		{
			TargetType = Bullets
			BulletTargetCategories = [laser, missile, mine, bullet]
			Toggle = DefendToggle
		}
		{
			TargetType = ShipParts
			Toggle = AttackToggle
			Overridable = true
		}
		{
			TargetType = Crew
			Toggle = AttackToggle
			Overridable = true
		}
	]
}

Indicators	// Add indicators
[
	// Scorched
	{
		Toggle = ScorchedToggle
		AtlasSprite = &/INDICATORS/Scorched
		HidesIndicators = [1,2,3,4]
	}
	// Turned off.
	{
		Toggle = PowerToggle
		AtlasSprite
		{
			File = &/INDICATORS/PowerOff
			Size = [1, 1]
		}
		HidesIndicators = [2,3,4]
	}

	// Out of power.
	{
		Toggle = BatteryStorage
		AtlasSprite
		{
			File = &/INDICATORS/NoPower
			Size = [1, 1]
		}
	}

	// Resetting from overclock
	{
		Toggle = &<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/OVERCLOCK_OPERATIONAL
		AtlasSprite : /INDICATORS/OverclockReset
		{
			Size = [1, 1]
		}
		HidesIndicators = [4]
	}
				
	// No crew.
	{
		Toggle = PartCrew
		AtlasSprite
		{
			File = &/INDICATORS/NoCrew
			Size = [1, 1]
		}
	}
]

Stats
{
	// Path modified
	DamagePerShot = (&<./Data/../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft/HitNothing/HitEffects/1/TotalDamage/BaseValue)
	ShotDamagePerShot = (&<./Data/../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft/HitNothing/HitEffects/0/TotalDamage/BaseValue)
	Range = (&<./Data/../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft/Range/BaseValue) //(&<./Data/../../../workshop/content/799600/2995534359/shots/galvanic_bolt/galvanic_bolt.rules>/Range)
	// Not modified
	ROF = 1 / (&<./Data/../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/FireTimer/Duration)
	DamagePerSecond = (&DamagePerShot) * (&ROF)
	ShotDamagePerSecond = (&ShotDamagePerShot) * (&ROF)
	PowerPerShot = (&<./Data/../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft/ResourcesUsed) / 1000
	// Standarized
	NearScale = (&<./Data/../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft/HitEffectsScaleOverRange/0) // (&<./Data/../../../workshop/content/799600/2995534359/shots/galvanic_bolt/galvanic_bolt.rules>/HitEffectsScaleOverRange/0)
	FarScale = (&<./Data/../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft/HitEffectsScaleOverRange/1) // (&<./Data/../../../workshop/content/799600/2995534359/shots/galvanic_bolt/galvanic_bolt.rules>/HitEffectsScaleOverRange/1)
	DamageContinuousNear = (&DamagePerSecond) * (&NearScale)
	DamageContinuousFar = (&DamagePerSecond) * (&FarScale)
	// New
	ShotContinuousDamageNear = (&ShotDamagePerSecond) * (&NearScale)
	ShotContinuousDamageFar = (&ShotDamagePerSecond) * (&FarScale)
	PowerUsageContinuous = (&PowerPerShot) * (&ROF)
	DamageArea = (&<./Data/../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft/HitNothing/HitEffects/1/Radius/BaseValue)
}