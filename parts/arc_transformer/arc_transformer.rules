OVERCLOCK
{
	BATTERY_CAPACITY_FACTOR = 300%
	ARC_CAPACITY_FACTOR = 300%
	ARC_INTERVAL_FACTOR = 50%	// Double speed
	
	HEAT_PER_ARC = 1200
	HEAT_PER_SECOND = (&HEAT_PER_ARC) / ((&~/Components/ConvertFromBatteryToArcEnergy/Interval/BaseValue) * (&ARC_INTERVAL_FACTOR))
	
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

BatteryStorage_MaxResources = 4000	// Reduce energy storage
TransformerArcEnergyStorage_MaxResources = 4000	// Increase arc storage
ReceivableBuffs = [Overclock, ArcHeatCollector]	// Add buffs
BatteryConsumer_Storage = Combined_BatteryStorage

Part
{
	EditorParentParts = [ "fariel.arc_emitter" ]
		
	Resources	// Reduce cost
	[
		[steel, 36]
		[coil2, 22]
		[processor, 3]
	]

	SecondaryToolTip	// Add overclock stats
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/ArcTransformerOverclockDesc"
		Stats
		{
			HeatGenerationPerArc = [&~/OVERCLOCK/HEAT_PER_ARC, &~/OVERCLOCK/HEAT_PER_SECOND]
			PowerCapacity = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/BatteryStorage/MaxResources) / 1000 * (&~/OVERCLOCK/BATTERY_CAPACITY_FACTOR)
			Interval = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/ConvertFromBatteryToArcEnergy/Interval/BaseValue) * (&~/OVERCLOCK/ARC_INTERVAL_FACTOR)
			ArcEnergy = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/ConvertFromBatteryToArcEnergy/ToQuantity) / 1000
			Power = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/ConvertFromBatteryToArcEnergy/From/0/Quantity) / 1000
			ArcEnergyGeneration = (&ArcEnergy) / (&Interval)
			ArcEnergyCapacity = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/TransformerArcEnergyStorage/MaxResources) / 1000 * (&~/OVERCLOCK/ARC_CAPACITY_FACTOR)
			PowerUsageContinuous = (&Power) / (&Interval)
		}
	}
}

Components
{
	IsOperational	
	{
		Type = MultiToggle
		Toggles = [PowerToggle, BatteryStorage, PartCrew, ScorchedToggle]
		Mode = All
	}

	CommandConsumptionToggle
	{
		Type = MultiToggle
		Toggles = [PowerToggle, ScorchedToggle]
		Mode = All
	}
	
	ScorchedToggle
	{
		Type = StatusToggle
		StatusType = cosmoteer.scorched
		MinStatusValue = 1
		Invert = true
	}

	CommandConsumer
	{
		Type = CommandConsumer
		OperationalToggle = CommandConsumptionToggle
		CommandPoints = 4	// Increase command points cost
	}
	
	ModularOverclockStateValue
	{
		Type = MultiValue
		ViaBuffs
		{
			IncomingBuffTypes = [Arc_Emitter_Capacity]
			ComponentIDs = [OverclockStateValue]
		}
		Mode = Max
	}
	IsOverclocked
	{
		Type = ThresholdToggle
		ValueFrom = ModularOverclockStateValue
		MinAmount = 0
		MaxAmount = 0
		Invert = true
	}
	
	ModularOverclockModeToggle
	{
		Type = MultiToggle
		ViaBuffs
		{
			IncomingBuffTypes = [Arc_Emitter_Capacity]
			ComponentIDs = [OverclockModeToggle]
		}
		Mode = Any
	}
	
	OverclockBuff
	{
		Type = SelfBuffProvider
		OperationalToggle = IsOverclocked
		BuffType = Overclock
		BuffMultiplier = ModularOverclockStateValue
	}
	
	OverflowHeatStorage : <./Data/ships/terran/base_part_terran_overclock.rules>/Part/Components/OverflowHeatStorage {}	// The game ask for it though I can't find were
	HeatDistributionStorage : <./Data/ships/terran/base_part_terran_overclock.rules>/Part/Components/HeatDistributionStorage	// Is HEAT_TARGET_STORAGE
	{
		ResourceStorages = [Overclock_CombinedHeatInput, OverflowHeatStorage]
	}
	NetworkHeatInput : <./Data/ships/terran/base_part_terran_overclock.rules>/Part/Components/NetworkHeatInput {}	// Is HEAT_NETWORK_INPUT
	
	Overclock_ArcGenerationTrigger
	{
		Type = ValueChangeTrigger
		OperationalToggle = IsOverclocked
		ValueSource = Combined_TransformerArcEnergyStorage
		TriggerOnDecrease = false
	}

	Overclock_GenerationHeatProducer
	{
		Type = ResourceChange
		ResourceStorage = HeatDistributionStorage
		Trigger = Overclock_ArcGenerationTrigger
		Amount { BaseValue=ceil((&~/OVERCLOCK/HEAT_PER_ARC) * (&~/HEAT_TO_RESOURCE)); EffectScaleExponent=1 }
	}
	
	Overclock_CombinedHeatInput
	{
		Type = MultiResourceStorage
		ResourceType = heat
		ResourceStorages = [ NetworkHeatInput ]
		ViaBuffs
		{
			IncomingBuffTypes = [ ArcHeatCollector ]
			ComponentIDs = [ ArcHeatCollectionStorage ]
		}
	}
	
	ScorchedTrigger
	{
		Type = ToggleTrigger
		Toggle = ScorchedToggle
		TriggerWhenOn = false
	}

	ScorchedEffects
	{
		Type = TriggeredEffects
		Trigger = ScorchedTrigger
		Location = &<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/DestroyedEffects/Location
		MediaEffects = &/COMMON_EFFECTS/BigPartScorched
	}

	PeakHeatGenerationStatValue
	{
		Type = StaticValue
		Value = (&~/OVERCLOCK/HEAT_PER_SECOND)
	}
	HeatGenerationStatProvider
	{
		Type = StatProvider
		Stat = HeatGeneration
		OperationalToggle = ModularOverclockModeToggle
		ValueFrom = PeakHeatGenerationStatValue
	}

/*	NotReadyToggle	// Required to make it shot only at full capacity
	{
		Type = MultiToggle
		Toggles = [PowerToggle, { Toggle = TransformerArcEnergyStorage; Invert = true} ]
		Mode = All
	}
*/

	ConvertFromBatteryToArcEnergy
	{
		Type = ResourceConverter
		OperationalToggle = IsOperational
		From
		[
			{
				Storage = Combined_BatteryStorage
				Quantity = 1000	// Increase quantity
				MinQuantityForConversion = 1000	// Increase minimum quantity
			}
		]
		ToStorage = Combined_TransformerArcEnergyStorage
		ToQuantity = 1000	// Increase quantity
		Interval
		{
			BaseValue = 1.5 // Increase interval
			Modifiers
			[
				{
					Type = BuffRemap
					BuffType = Overclock
					ModificationMode = Multiply
					RemapFrom = [0, 1]
					RemapTo = [1, &~/OVERCLOCK/ARC_INTERVAL_FACTOR]
				}
			]
		}
	}

	// Add crew requirement
	CrewLocation1
	{
		Type = CrewLocation
		Location = [1.5, 2.3]
		Rotation = 0d
	}
	CrewLocation2
	{
		Type = CrewLocation
		Location = [.7, 1.5]
		Rotation = 90d
	}
	CrewLocation3
	{
		Type = CrewLocation
		Location = [1.5, .7]
		Rotation = 180d
	}
	CrewLocation4
	{
		Type = CrewLocation
		Location = [2.3, 1.5]
		Rotation = -90d
	}
	PartCrew
	{
		Type = PartCrew
		Crew = 1
		DefaultPriority = &/PRIORITIES/Weapon_Crew
		PrerequisitesBeforeCrewing = [PowerToggle]
		CrewDestinations
		[
			[1.5, 2.3]
			[.7, 1.5]
			[1.5, .7]
			[2.3, 1.5]
		]
		CrewLocations
		[
			CrewLocation1
			CrewLocation2
			CrewLocation3
			CrewLocation4
		]
		SwitchLocationInterval = [5, 10]
	}
	
	Overclock_ToggledTransformerArcEnergyStorage
	{
		Type = ToggledComponents
		Toggle = IsOverclocked
		Components
		{
			Overclock_TransformerArcEnergyStorage
			{
				Type = ResourceStorage
				ResourceType = arc_energy
				MaxResources = "ceil((&~/TransformerArcEnergyStorage_MaxResources) * ((&~/OVERCLOCK/ARC_CAPACITY_FACTOR) - 1))"
			}
		}
	}
	Overclock_TransformerArcEnergyStorage_Proxy
	{
		Type = ResourceStorageProxy
		ResourceType = arc_energy
		ProxyToggle = IsOverclocked
		ComponentID = Overclock_TransformerArcEnergyStorage
	}
	
	Combined_TransformerArcEnergyStorage
	{
		Type = MultiResourceStorage
		ResourceType = arc_energy
		ResourceStorages = [ TransformerArcEnergyStorage, Overclock_TransformerArcEnergyStorage_Proxy ]
		AddMode = InOrder
		RemoveMode = InReverseOrder
		ProvidedValueRange = 0
		ProvidedValuePerResource = 1/1000
	}
	
	Overclock_ToggledBatteryStorage
	{
		Type = ToggledComponents
		Toggle = IsOverclocked
		Components
		{
			Overclock_BatteryStorage
			{
				Type = ResourceStorage
				ResourceType = battery
				MaxResources = "ceil((&~/BatteryStorage_MaxResources) * ((&~/OVERCLOCK/BATTERY_CAPACITY_FACTOR) - 1))"
			}
		}
	}
	Overclock_BatteryStorage_Proxy
	{
		Type = ResourceStorageProxy
		ResourceType = battery
		ProxyToggle = IsOverclocked
		ComponentID = Overclock_BatteryStorage
	}
	
	Combined_BatteryStorage
	{
		Type = MultiResourceStorage
		ResourceType = battery
		ResourceStorages = [ BatteryStorage, Overclock_BatteryStorage_Proxy ]
		AddMode = InOrder
		RemoveMode = InReverseOrder
	}
	
	// Graphics
	
	NonOverclocked
	{
		Type = MultiToggle
		Toggles = [IsOverclocked]
		Invert = true
		Mode = All
	}
	
	Toggled_NonOverclocked	// Change graphic
	{
		Type = ToggledComponents
		Toggle = NonOverclocked
		Components
		{
			BatterySprites
			{
				Type = ResourceSprites
				Location = [1.5, 1.5]
				ResourceStorage = Combined_BatteryStorage
				Layer = "doodads_low"
				ResourceLevels
				[
					{
						File = "arc_transformer_power_3.png"
						Size = [3, 3]
					}
					{
						File = "arc_transformer_power_6.png"
						Size = [3, 3]
					}
					{
