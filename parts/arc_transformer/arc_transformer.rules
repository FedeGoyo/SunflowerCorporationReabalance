Resources	// Reduce cost
[
	[steel, 36]
	[coil2, 22]
	[processor, 3]
]

Components
{
/*	Does't work as the Arc Emitter completely ignore it
	EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = 5000
			RecoveryRate = (&AbsorbsResourceDrain) * 0.1
		}
*/



/*	NotReadyToggle	// Required to make it shot only at full capacity
	{
		Type = MultiToggle
		Toggles = [PowerToggle, { Toggle = TransformerArcEnergyStorage; Invert = true} ]
		Mode = All
	}
*/

	// Add crew requirement
	CrewLocation1
	{
		Type = CrewLocation
		Location = [1.5, 2.3]
		Rotation = 0d
	}
	CrewLocation2
	{
		Type = CrewLocation
		Location = [.7, 1.5]
		Rotation = 90d
	}
	CrewLocation3
	{
		Type = CrewLocation
		Location = [1.5, .7]
		Rotation = 180d
	}
	CrewLocation4
	{
		Type = CrewLocation
		Location = [2.3, 1.5]
		Rotation = -90d
	}
	PartCrew
	{
		Type = PartCrew
		Crew = 1
		DefaultPriority = &/PRIORITIES/Weapon_Crew
		PrerequisitesBeforeCrewing = [PowerToggle]
		CrewDestinations
		[
			[1.5, 2.3]
			[.7, 1.5]
			[1.5, .7]
			[2.3, 1.5]
		]
		CrewLocations
		[
			CrewLocation1
			CrewLocation2
			CrewLocation3
			CrewLocation4
		]
		SwitchLocationInterval = [5, 10]
	}
}

TransformerArcEnergyStorage
{
	ToggleOnResources = 4000
	ToggleOffResources = 0
}

ConvertFromBatteryToArcEnergy
{
	From
	[
		{
			Storage = BatteryStorage
			Quantity = 2000	// Increase quantity
			MinQuantityForConversion = 2000	// Increase minimum quantity
		}
	]
	ToQuantity = 1000	// Increase quantity
	Interval = 1.25	// Increase interval
}

BatteryStorage
{
	ToggleOnResources = 2000
	ToggleOffResources = 1999
}
	
