Indicators	// Add indicators
[
	// Scorched
	{
		Toggle = ScorchedToggle
		AtlasSprite = &/INDICATORS/Scorched
		HidesIndicators = [1,2,3]
	}
	// Turned off.
	{
		Toggle = PowerToggle
		AtlasSprite
		{
			File = &/INDICATORS/PowerOff
			Size = [1, 1]
		}
		HidesIndicators = [2,3]
	}

	// Out of power.
	{
		Toggle = BatteryStorage
		AtlasSprite
		{
			File = &/INDICATORS/NoPower
			Size = [1, 1]
		}
	}
				
	// No crew.
	{
		Toggle = PartCrew
		AtlasSprite
		{
			File = &/INDICATORS/NoCrew
			Size = [1, 1]
		}
	}
]

Stats
{
	CrewRequired = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/PartCrew/Crew)
	RecPower = (&PowerUsageContinuous)
	RecCrew = (&CrewRequired) + (&RecPower) * 4

	Interval = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/ConvertFromBatteryToArcEnergy/Interval/BaseValue)
	ArcEnergy = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/ConvertFromBatteryToArcEnergy/ToQuantity) / 1000
	Power = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/ConvertFromBatteryToArcEnergy/From/0/Quantity) / 1000
	ArcEnergyGeneration = (&ArcEnergy) / (&Interval)
	ArcEnergyCapacity = (&<./Data/../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/TransformerArcEnergyStorage/MaxResources) / 1000
	PowerUsageContinuous = (&Power) / (&Interval)

//	ArcEnergyConversionRate = [(&ArcEnergy), (&Power)]
}