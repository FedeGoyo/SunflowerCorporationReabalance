					}
					{
						File = "arc_transformer_power_12.png"
						Size = [3, 3]
					}
				]
			}
			
			ArcEnergySprites
			{
				Type = ResourceSprites
				Location = [1.5, 1.5]
				ResourceStorage = Combined_TransformerArcEnergyStorage
				Layer = "doodads_low"
				ResourceLevels
				[
					{
						File = "arc_transformer_arc_3.png"
						Size = [3, 3]
					}
					{
						File = "arc_transformer_arc_6.png"
						Size = [3, 3]
					}
					{
						File = "arc_transformer_arc_9.png"
						Size = [3, 3]
					}
					{
						File = "arc_transformer_arc_12.png"
						Size = [3, 3]
					}
				]
			}
		}
	}
	
	Toggled_IsOverclocked	// Add Overclock graphic
	{
		Type = ToggledComponents
		Toggle = IsOverclocked
		Components
		{
			Overclocked_BatterySprites	
