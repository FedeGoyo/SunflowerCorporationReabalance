	}

	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
	}

	StatsByCategory
	[
		{
			NameKey = "StatCategories/ArcBeam"
			Stats
			{
//				BaseDamage = &~/Part/Components/ArcEmitter/HitNothing/HitEffects/0/Damage/BaseValue
//				HitInterval = &~/Part/Components/ArcEmitter/HitInterval
//				Duration = &~/Part/Components/ArcEmitter/Duration
				ROF = 1 / (&~/Part/Components/Weapon/FireInterval)
//				DamagePerShot = (&BaseDamage) * ((&Duration) / (&HitInterval))
//				DamagePerSecond = (&DamagePerShot) * (&ROF)
//				Damage = [&../DamagePerShot, &../DamagePerSecond]
