			IncludeInBlueprints = false;
			Components
			{
				ShotBuffProvider3
				{
					Type = SelfBuffProvider
					BuffType = Arc_Emitter_Shot
					BuffAmount = { BaseValue=3; BuffType=Arc_Emitter_Shot; BuffMode=Replace; }
				}
			}
		}
		ThresholdToggle4
		{
			Type = ThresholdToggle
			AmountFrom = ArcEmitterStorageProxy
			MinAmount = 4
			MaxAmount = 4
		}
		ThresholdToggler4
		{
			Type = ToggledComponents
			Toggle = ThresholdToggle4
			IncludeInBlueprints = false;
			Components
			{
				ShotBuffProvider4
				{
					Type = SelfBuffProvider
					BuffType = Arc_Emitter_Shot
					BuffAmount = { BaseValue=4; BuffType=Arc_Emitter_Shot; BuffMode=Replace; }
				}
			}
