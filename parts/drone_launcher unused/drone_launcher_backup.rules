Part :<./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/ArcEmitterName"
	IconNameKey = "Parts/ArcEmitterIcon"
	ID = enderluck.drone_launcher // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	OtherIDs = [drone_launcher]
	EditorGroup = "WeaponsEnergy"
	DescriptionKey = "Parts/ArcEmitterDesc"
	Resources
	[
		[steel, 80]
		[coil, 20]
		[coil2, 40]
		[tristeel, 50]
	]
	Size = [3, 3]
	PhysicalRect = [0, 0, 3, 3]
	SaveRect = &PhysicalRect
	SelectionPriority = 1
	MaxHealth = 8000
	TypeCategories = [weapon, uses_power, is_crewed, arc, arc_emitter]
	ReceivableBuffs : ^/0/ReceivableBuffs [Arc_Emitter_Shot]
	ProhibitedBy : ^/0/ProhibitedBy [tall]
	ForceManhattanPathInPart = true
	BlockedTravelCells
	[
		[1, 1]
	]
	AllowedDoorLocations
	[
		[-1, 1]
		[3, 1]
		[1, -1]
		[1, 3]
	]

	EditorIcon
	{
		Texture
		{
			File = "arc_emitter_icon.png"
			SampleMode = Linear
		}
		Size = [64, 64]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, PartCrew]
			Mode = All
		}

		OperationalWithPower
		{
			Type = MultiToggle
			Toggles = [ArcEmitterStorageProxy, IsOperational]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = PowerToggle
			CommandPoints = 4
		}

		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			AvailableChoices = [-1, 1]
			ToggledOnChoices = [0, 1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}
		

		BuffProvider
		{
			Type = GridBuffProvider
			BuffType = Arc_Emitter_Capacity
			GridDistance = 1
			OperationalToggle = IsOperational
		}
		ArcEmitterStorageProxy
		{
			Type = MultiResourceStorage
			OperationalToggle = IsOperational
			ResourceType = arc_energy
			ToggleOnResources = 0
			ProvidedValueRange = 0
			ProvidedValuePerResource = 1/4
			IsDrainable = false
			ResourceStorages = []
			ViaBuffs
			{
				OutgoingBuffProviders = [BuffProvider]
				ComponentID = TransformerArcEnergyStorage
			}
			AddMode = PrioritizeLeastResources
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}

		Weapon
		{
			Type = TurretWeapon
			Location = [1, 1]// Relative to upper-left corner of unrotated part.
			Rotation = -90d// Relative to unrotated part.
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = 3
			FiringArc = 200d
			RotateSpeed = 0d
			FireThresholdAngle = 200d
			AIFirepowerRating = 400
			Emitter = BulletEmitter
			AllowFireWithBlockedLOS = true
			FirePermissionToggle = FireModeToggle
			HoldTargetAfterCancel = &../BulletEmitter/FireDelay
			AutoTargetCrewSafetyDist = 8

			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]

			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64

			CoverageSectorArc
			{
				Texture = &/INDICATORS/VerticalGradient
				VertexColor = [255, 255, 255, 51]
				QuadCount = 64
			}
		}

		ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = Weapon
		}

		BulletEmitter
		{
			Type = BulletEmitter
			ChainedTo = Weapon
			FireTrigger = Weapon
			GetTargetFrom = Weapon
			Location = [1, 0]
			OperationalToggle = IsOperational
			FireDelay = 1
			Bullet = &<../../shots/energy_drone/energy_drone_shot.rules>
			ResourceStorage = BatteryStorage
			ResourcesUsed = 10000
			MinResourcesUsed = 10000
		}

		TurnTimer
		{
			Type = Timer
			OperationalToggle = IsOperational
			Duration = 1.1
			StartTrigger = Weapon
			AutoStart = true
		}
		

		TurretCollider
		{
			Type = CircleCollider
			Location = &../Weapon/Location
			Radius = 1.5
			IsHigh = true
		}

		CrewLocation1
		{
			Type = CrewLocation
			Location = [1.5, 2.3]
			Rotation = 0d
		}
		CrewLocation2
		{
			Type = CrewLocation
			Location = [.7, 1.5]
			Rotation = 90d
		}
		CrewLocation3
		{
			Type = CrewLocation
			Location = [1.5, .7]
			Rotation = 180d
		}
		CrewLocation4
		{
			Type = CrewLocation
			Location = [2.3, 1.5]
			Rotation = -90d
		}
		CrewLocation5
		{
			Type = CrewLocation
			Location = [.5, .5]
			Rotation = -45d
		}
		CrewLocation6
		{
			Type = CrewLocation
			Location = [2.5, .5]
			Rotation = 45d
		}
		CrewLocation7
		{
			Type = CrewLocation
			Location = [.5, 2.5]
			Rotation = -135d
		}
		CrewLocation8
		{
			Type = CrewLocation
			Location = [2.5, 2.5]
			Rotation = 135d
		}
		PartCrew
		{
			Type = PartCrew
			Crew = 4
			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [PowerToggle]
			CrewDestinations
			[
				[1.5, 2.3]
				[.7, 1.5]
				[1.5, .7]
				[2.3, 1.5]
				[.5, .5]
				[2.5, .5]
				[.5, 2.5]
				[2.5, 2.5]
			]
			CrewLocations
			[
				CrewLocation1
				CrewLocation2
				CrewLocation3
				CrewLocation4
				CrewLocation5
				CrewLocation6
				CrewLocation7
				CrewLocation8
			]
			SwitchLocationInterval = [5, 10]
		}

		Graphics
		{
			Type = Graphics
			Location = [1.5, 1.5]
			OperationalToggle = OperationalWithPower
			ShowToggledDoodadsWhenNotOperational = false
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "arc_emitter_floor.png"
						Size = [3, 3]
					}
					{
						File = "arc_emitter_floor_33.png"
						Size = [3, 3]
					}
					{
						File = "arc_emitter_floor_66.png"
						Size = [3, 3]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"arc_emitter_doodads_1.png"
							"arc_emitter_doodads_2.png"
							"arc_emitter_doodads_3.png"
							"arc_emitter_doodads_2.png"
						]
						Size = [3, 3]
						AnimationInterval = 0.125
						AnimationStartTime = Zero
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "arc_emitter_walls.png"
						Size = [3, 3]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "arc_emitter_roof.png"
						NormalsFile = "arc_emitter_roof_normals.png"
						Size = [3, 3]
					}
					{
						File = "arc_emitter_roof_33.png"
						NormalsFile = "arc_emitter_roof_normals.png"
						Size = [3, 3]
					}
					{
						File = "arc_emitter_roof_66.png"
						NormalsFile = "arc_emitter_roof_normals.png"
						Size = [3, 3]

					}
				]
			}
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [1.5, 1.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOff
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [1.5, 1.5]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1.5, 1.5]
			Layer = "indicators"
			Indicators
			[
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
				}

				// Out of power.
				{
					Toggle = ArcEmitterStorageProxy
					Delay = &~/Part/Components/Weapon/FireInterval
					AtlasSprite
					{
						File = "../../buffs/arc_energy_red.png"
						Size = [1, 1]
					}
				}

				// No crew.
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "arc_emitter_blueprint.png"
			Size = [3, 3]
		}

		// Begin Buffs Based On Power Level...
		ThresholdToggle1
		{
			Type = ThresholdToggle
			AmountFrom = ArcEmitterStorageProxy
			MinAmount = 1
			MaxAmount = 1
		}
		ThresholdToggler1
		{
			Type = ToggledComponents
			Toggle = ThresholdToggle1
			IncludeInBlueprints = false;
			Components
			{
				ShotBuffProvider1
				{
					Type = SelfBuffProvider
					BuffType = Arc_Emitter_Shot
					BuffAmount = { BaseValue=1; BuffType=Arc_Emitter_Shot; BuffMode=Replace; }
				}
			}
		}
		ThresholdToggle2
		{
			Type = ThresholdToggle
			AmountFrom = ArcEmitterStorageProxy
			MinAmount = 2
			MaxAmount = 2
		}
		ThresholdToggler2
		{
			Type = ToggledComponents
			Toggle = ThresholdToggle2
			IncludeInBlueprints = false;
			Components
			{
				ShotBuffProvider2
				{
					Type = SelfBuffProvider
					BuffType = Arc_Emitter_Shot
					BuffAmount = { BaseValue=2; BuffType=Arc_Emitter_Shot; BuffMode=Replace; }
				}
			}
		}
		ThresholdToggle3
		{
			Type = ThresholdToggle
			AmountFrom = ArcEmitterStorageProxy
			MinAmount = 3
			MaxAmount = 3
		}
		ThresholdToggler3
