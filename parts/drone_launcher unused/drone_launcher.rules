Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/ArcEmitterName"
	IconNameKey = "Parts/ArcEmitterIcon"
	ID = enderluck.drone_launcher // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	OtherIDs = [drone_launcher]
	EditorGroup = "WeaponsEnergy"
	DescriptionKey = "Parts/ArcEmitterDesc"
	Resources
	[
		[steel, 80]
		[coil, 20]
		[coil2, 40]
		[tristeel, 50]
	]
	Size = [3, 3]
	PhysicalRect = [0, 0, 3, 3]
	SaveRect = &PhysicalRect
	SelectionPriority = 1
	MaxHealth = 8000
	TypeCategories = [weapon, uses_power, is_crewed, arc, arc_emitter]
	ReceivableBuffs : ^/0/ReceivableBuffs [Arc_Emitter_Shot]
	ProhibitedBy : ^/0/ProhibitedBy [tall]
	ForceManhattanPathInPart = true
	BlockedTravelCells
	[
		[1, 1]
	]
	AllowedDoorLocations
	[
		[-1, 1]
		[3, 1]
		[1, -1]
		[1, 3]
	]

	EditorIcon: &<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/EditorIcon

	Components : &<./Data/ships/terran/base_part_terran.rules>/Part/Components // ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, PartCrew]
			Mode = All
		}

		OperationalWithPower
		{
			Type = MultiToggle
			Toggles = [ArcEmitterStorageProxy, IsOperational]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = PowerToggle
			CommandPoints = 4
		}

		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			AvailableChoices = [-1, 1]
			ToggledOnChoices = [0, 1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}
		

		BuffProvider
		{
			Type = GridBuffProvider
			BuffType = Arc_Emitter_Capacity
			GridDistance = 1
			OperationalToggle = IsOperational
		}
		ArcEmitterStorageProxy
		{
			Type = MultiResourceStorage
			OperationalToggle = IsOperational
			ResourceType = arc_energy
			ToggleOnResources = 0
			ProvidedValueRange = 0
			ProvidedValuePerResource = 1/2000
			IsDrainable = false
			ResourceStorages = []
			ViaBuffs
			{
				OutgoingBuffProviders = [BuffProvider]
				ComponentID = TransformerArcEnergyStorage
			}
			AddMode = PrioritizeLeastResources
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}

		Weapon
		{
			Type = TurretWeapon
			Location = [1.5, 1.5]// Relative to upper-left corner of unrotated part.
			Rotation = -90d// Relative to unrotated part.
			OperationalToggle = OperationalWithPower
			AutoFireToggle = AutoFireToggle
			FirePermissionToggle = FireModeToggle
			TargetingArc = 360d
			TargetingRange = 300
			FiringArc = 360d
			RotateSpeed = 2080d
			FireThresholdAngle = 1d
			FireInterval = 2
			AIFirepowerRating = 400
			Emitter = BulletEmitter
			IgnoreFriendlyShipLowLOSChecks = true
			IgnoreFriendlyShipHighLOSChecks = true
			IgnoreJunkLOSChecks = true
			ReturnToCenter = false
//			AllowFireWithBlockedLOS = true
			HoldTargetAfterCancel = &../BulletEmitter/FireDelay
			AutoTargetCrewSafetyDist = 8

			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]

		}

		ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = Weapon
		}

		BulletEmitter
		{
			Type = BulletEmitter
			ChainedTo = Weapon
			FireTrigger = Weapon
			GetTargetFrom = Weapon
			Location = [0, 0]
			OperationalToggle = IsOperational
			FireDelay = 1
			Bullet = &<./Data/../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>
			ResourceStorage = ArcEmitterStorageProxy
			ResourcesUsed = 1000
			MinResourcesUsed = 1000
		}

		TurnTimer
		{
			Type = Timer
			OperationalToggle = IsOperational
			Duration = 1.1
			StartTrigger = Weapon
			AutoStart = true
		}
		

		TurretCollider
		{
			Type = CircleCollider
			Location = &../Weapon/Location
			Radius = 1.5
			IsHigh = true
		}

		CrewLocation1
		{
			Type = CrewLocation
			Location = [1.5, 2.3]
			Rotation = 0d
		}
		CrewLocation2
		{
			Type = CrewLocation
			Location = [.7, 1.5]
			Rotation = 90d
		}
		CrewLocation3
		{
			Type = CrewLocation
			Location = [1.5, .7]
			Rotation = 180d
		}
		CrewLocation4
		{
			Type = CrewLocation
			Location = [2.3, 1.5]
			Rotation = -90d
		}
		CrewLocation5
		{
			Type = CrewLocation
			Location = [.5, .5]
			Rotation = -45d
		}
		CrewLocation6
		{
			Type = CrewLocation
			Location = [2.5, .5]
			Rotation = 45d
		}
		CrewLocation7
		{
			Type = CrewLocation
			Location = [.5, 2.5]
			Rotation = -135d
		}
		CrewLocation8
		{
			Type = CrewLocation
			Location = [2.5, 2.5]
			Rotation = 135d
		}
		PartCrew
		{
			Type = PartCrew
			Crew = 4
			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [PowerToggle]
			CrewDestinations
			[
				[1.5, 2.3]
				[.7, 1.5]
				[1.5, .7]
				[2.3, 1.5]
				[.5, .5]
				[2.5, .5]
				[.5, 2.5]
				[2.5, 2.5]
			]
			CrewLocations
			[
				CrewLocation1
				CrewLocation2
				CrewLocation3
				CrewLocation4
				CrewLocation5
				CrewLocation6
				CrewLocation7
				CrewLocation8
			]
			SwitchLocationInterval = [5, 10]
		}

		Graphics: "&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Components/Graphics"
		
		OperationEffects
		{
			Type = ToggleEffects
			Location = [1.5, 1.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOff
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [1.5, 1.5]
		}

