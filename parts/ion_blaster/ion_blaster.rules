OVERCLOCK
{
	HEAT_PER_SHOT = 750
}

HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

ReceivableBuffs : &<./Data/ships/base_part_overclock.rules>/Part/ReceivableBuffs [ElectronBuff]	// Add Buffs

Part
{
	SecondaryToolTip	// Add overclock stats
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/IonBlasterOverclockDesc"
		StatsByCategory
		[
			{
				NameKey = "StatCategories/IonBlasterShotOverclock"
				Stats
				{
					HeatPerShot = (&~/OVERCLOCK/HEAT_PER_SHOT)
				}
			}
			{
				NameKey = "StatCategories/IonBlasterRayOverclock"
				Stats
				{
					Lifetime = (&<../../shots/ion_blaster/overclock/ion_scatter_ray_overclock.rules>/Components/DeployDeath/Lifetime)
					SPEED_TRAVEL = (&<../../shots/ion_blaster/overclock/ion_scatter_ray_overclock.rules>/Speed)
					SPEED_PENETRATION = (&<../../shots/ion_blaster/overclock/ion_scatter_ray_overclock.rules>/Components/Hit/PenetrationSpeed)
					ShotSpeedPenetration = [&../SPEED_TRAVEL, &../SPEED_PENETRATION]
					MAXIMUM_DAMAGE = (&<../../shots/ion_blaster/overclock/ion_scatter_ray_overclock.rules>/Components/DamagePool/Damage/BaseValue)
					PenetrationDamagePool = [infinity, &../MAXIMUM_DAMAGE]
					CrewStunRadius = (&<../../shots/ion_blaster/overclock/ion_scatter_ray_overclock.rules>/Components/Hit/HitOperational/HitEffects/2/Radius)
				}
			}
		]
	}
}

Components
{
	IsOperational
	{
		Type = MultiToggle
		Toggles = [PowerToggle, BatteryStorage, PartCrew, ScorchedToggle, &<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/OVERCLOCK_OPERATIONAL]
		Mode = All
	}
	
	IsOperationalNonOverclocked
	{
		Type = MultiToggle
		Toggles = [ IsOperational, { Toggle=IsOverclocked; Invert=true } ]
		Mode = All
	}

	CommandConsumptionToggle
	{
		Type = MultiToggle
		Toggles = [PowerToggle, ScorchedToggle]
		Mode = All
	}
	
	ScorchedToggle
	{
		Type = StatusToggle
		StatusType = cosmoteer.scorched
		MinStatusValue = 1
		Invert = true
	}

	CommandConsumer
	{
		Type = CommandConsumer
		OperationalToggle = CommandConsumptionToggle
		CommandPoints = 3
	}
	
	Overclock_BulletEmitter : <./Data/../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/Components/BulletEmitter
	{
		OperationalToggle = IsOperationalOverclocked
		Bullet = &<../../shots/ion_blaster/overclock/ion_blaster_shot_overclock.rules>
	}
	
	WeaponEmitterSelector
	{
		Type = ToggleEmitterSelector
		Toggle = IsOverclocked
		ToggleOffEmitter = BulletEmitter
		ToggleOnEmitter = Overclock_BulletEmitter
	}

	OverclockStateValue
	{
		Type = ToggleValueSelector
		Toggle = OverclockModeToggle
		ToggleOffValue = Zero
		ToggleOnValue = One
	}

	Zero { Type = StaticValue; Value = 0; }
	One { Type = StaticValue; Value = 1; }
	
	Overclock_ShotHeatProducer
	{
		Type = ResourceChange
		ResourceStorage = HeatDistributionStorage
		Trigger = Overclock_BulletEmitter
		Amount
		{
			BaseValue = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/HEAT_TO_RESOURCE)
			Modifiers
			[
				{
					Type = Buff
					BuffType = Arc_Energy_Heat_Multiplier
					ModificationMode = Multiply
				}
			]
		}
	}
	
	Port_Thermal_Left : <./Data/../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/BASE_THERMAL_PORT
	{
		Location = [0, 2]
		Direction = Left
	}
	Port_Thermal_Right : Port_Thermal_Left
	{
		Direction = Right
	}
	Port_Thermal_Down : Port_Thermal_Left
	{
		Direction = Down
	}
	
	ScorchedTrigger
	{
		Type = ToggleTrigger
		Toggle = ScorchedToggle
		TriggerWhenOn = false
	}

	ScorchedEffects
	{
		Type = TriggeredEffects
		Trigger = ScorchedTrigger
		Location = &<./Data/../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/Components/DestroyedEffects/Location
		MediaEffects = &/COMMON_EFFECTS/BigPartScorched
	}

	PeakHeatGenerationValue
	{
		Type = StaticValue
		SHOT_HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_SHOT) //* (&~/Part/SecondaryToolTip/StatsByCategory/0/Stats/ROF)
		Value = (&SHOT_HEAT_PER_SECOND)
	}
	HeatGenerationStatProvider
	{
		Type = StatProvider
		Stat = HeatGeneration
		OperationalToggle = OverclockModeToggle
		ValueFrom = PeakHeatGenerationValue
	}
}

Indicators
[
	// Scorched
	{
		Toggle = ScorchedToggle
		AtlasSprite = &/INDICATORS/Scorched
		HidesIndicators = [1,2,3,4]
	}
	// Turned off.
	{
		Toggle = PowerToggle
		AtlasSprite
		{
			File = &/INDICATORS/PowerOff
			Size = [1, 1]
		}
		HidesIndicators = [2,3,4]
	}

	// Out of power.
	{
		Toggle = BatteryStorage
		Delay = &<./Data/../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/Components/Turret/FireInterval
		AtlasSprite
		{
			File = &/INDICATORS/NoPower
			Size = [1, 1]
		}
	}
	
	// Resetting from overclock
	{
		Toggle = &<./Data/../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/OVERCLOCK_OPERATIONAL
		AtlasSprite : /INDICATORS/OverclockReset
		{
			Size = [1, 1]
		}
		HidesIndicators = [4]
	}

	// No crew.
	{
		Toggle = PartCrew
		AtlasSprite
		{
			File = &/INDICATORS/NoCrew
			Size = [1, 1]
		}
	}
]

Turret
{
	FiringArc = 220d	// Increase firing arc
	FireThresholdAngle = 220d	// Increase firing arc
	RotateSpeed = 90d	// Add rotation speed
	FireInterval = 2	// Increase fire interval (slow down)
	Emitter = WeaponEmitterSelector
}
TurretCollider
{
	InitialPenetrationResistance = 5	// Add penetration resistance to the turret
}

BulletEmitter
{
	OperationalToggle = IsOperationalNonOverclocked	// Prevent firing when overclocked
	ResourceUsed = 1333		// Increased resource used
}

BaseStats
{
	TurretPenResist = (&"<./Data/../../../workshop/content/799600/2995534359/parts/ion_blaster/ion_blaster.rules>/Part/Components/TurretCollider/InitialPenetrationResistance")
}
IonBlasterShotStats
{
	Rays = ("&<./Data/../../../workshop/content/799600/2995534359/shots/ion_blaster/ion_blaster_shot.rules>/Components/Hit/HitOperational/HitEffects/1/Count")
}
StatsByCategory
{
	NameKey = "StatCategories/IonBlasterRay"
	Stats
	{
		DAMAGE_PER_TILE = (&<../../shots/ion_blaster/ion_scatter_ray.rules>/Components/Hit/HitOperational/HitEffects/0/Damage/BaseValue)
		PenetrationDamage = [infinity, &../DAMAGE_PER_TILE]
		ShotSpeed = (&<../../shots/ion_blaster/ion_scatter_ray.rules>/Speed)
		MIN_LIFETIME = (&<../../shots/ion_blaster/ion_scatter_ray.rules>/Components/DeployDeath/Lifetime/0)
		MAX_LIFETIME = (&<../../shots/ion_blaster/ion_scatter_ray.rules>/Components/DeployDeath/Lifetime/1)
		LifetimeRange = [&../MIN_LIFETIME, &../MAX_LIFETIME]
		ShotHP = infinity
		Spread = deg(&<./Data/../../../workshop/content/799600/2995534359/shots/ion_blaster/ion_blaster_shot.rules>/Components/Hit/HitOperational/HitEffects/1/Arc/1) + deg(&<./Data/../../../workshop/content/799600/2995534359/shots/ion_blaster/ion_blaster_shot.rules>/Components/Hit/HitOperational/HitEffects/1/Arc/0)
		FireChance = (&<../../shots/ion_blaster/ion_scatter_ray.rules>/Components/Hit/HitOperational/HitEffects/1/StatusChance/BaseValue) * 100
		CrewStunDuration = [0, (&<../../shots/ion_blaster/ion_scatter_ray.rules>/Components/Hit/HitOperational/HitEffects/2/Duration)]
		CrewStunRadius = (&<../../shots/ion_blaster/ion_scatter_ray.rules>/Components/Hit/HitOperational/HitEffects/2/Radius)
	}
}

