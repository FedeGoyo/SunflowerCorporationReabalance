ID = fariel.sunflowercorp.enderluck
Name = "Sunflower Corporation Rebalance"
Version = 1.0.0
CompatibleGameVersions = ["0.23.3"]
ModifiesMultiplayer = true
Author = "Enderluck"
Logo = "logo.png"
StringsFolder = "strings"

Description = "...."

Actions
[
// Rebalance Arc Emitter
	// Reduced cost
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Resources"
		With
		[
			[steel, 36]
			[coil2, 22]
			[processor, 3]
		]
	}
	// Add targeting
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/Weapon"
		IgnoreIfNotExisting = false
		Overrides = &<parts/arc_emitter/arc_emitter.rules>/Part/Components/Weapon
	}
	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components"
		Name = AutoTargetToggle
		ToAdd
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
	}
	// Reduced shared arc energy value
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitterStorageProxy/ProvidedValuePerResource"
		IgnoreIfNotExisting = false
		With = 1/2000
	}
	// Reduced minimum arc energy required
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/MinResourcesUsed"
		IgnoreIfNotExisting = false
		With = 4000
	}
	// Reduced fire interval
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/Weapon/FireInterval"
		IgnoreIfNotExisting = false
		With = 1
	}
	// Increase hit interval
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/lightning_bolt/lightning_bolt.rules>/HitInterval"
		IgnoreIfNotExisting = false
		With = 1/30
	}
	// Reduce damage
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/lightning_bolt/lightning_bolt.rules>/HitNothing/HitEffects/0/Damage/BaseValue"
		IgnoreIfNotExisting = false
		With = 400
	}
	// Add fire chance
	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/shots/lightning_bolt/lightning_bolt.rules>/HitNothing/HitEffects"
		Name = 1
		ToAdd
		{
			Type = Fire
			FireChance = .1
			TreatShieldAsPart = true
		}
	}	
	// New stats
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats"
		CreateIfNotExisting = true
		Overrides
		{
			MinimumArcRequired = 4000 / 1000  // References didn't work
			ArcEnergyShot = Infinity
			DamageArc = 400/2 / (1/30) * (1/30*22)
			/* Didn't Work
			BaseDamage = "&<./Data/../../../workshop/content/799600/2995534359/shots/lightning_bolt/lightning_bolt.rules>/HitNothing/HitEffects/0/Damage/BaseValue"
			Resource = "&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitterStorageProxy/ProvidedValuePerResource" / 1000
			HitInterval = "&<./Data/../../../workshop/content/799600/2995534359/shots/lightning_bolt/lightning_bolt.rules>/HitInterval"
			Duration = "&<./Data/../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter/Duration"
			DamageArc = (&BaseDamage) / (&Resource) / (&HitInterval) * (&Duration)
			*/
			
		}
	}
	// Remove
	{
		Action = RemoveMany
		RemoveMany = 
		[
			// Unused Stats
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats/DamagePerShot"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats/DamagePerSecond"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats/Damage"
			// No longer destroy shields
			"<../../../workshop/content/799600/2995534359/shots/lightning_bolt/lightning_bolt.rules>/HitNothing/HitEffects/0/TreatShieldAsPart"
			// To add targeting
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/FireModeToggle/AvailableChoices"
		]
	}



	{
		Action = Overrides
		OverrideIn = "&<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/Components/Hit"
		Overrides
		{
			SourceShipLowCollisions = false
			SourceShipHighCollisions = true
		}
	}
	{
		Action = Remove
		Remove = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/ArcEmitter"
	}
	{
		Action = Add
		AddTo = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components"
		Name = BulletEmitter
		//ToAdd = "&<drone_launcher.rules>/BulletEmitter"
		ToAdd
		{
			Type = BulletEmitter
			ChainedTo = Weapon
			FireTrigger = Weapon
			GetTargetFrom = Weapon
			Location = [0, 0]
//			OperationalToggle = IsOperational
			FireDelay = 1
			Bullet = &<./Data/../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>
			ResourceStorage = ArcEmitterStorageProxy
			ResourcesUsed = 1000
			MinResourcesUsed = 1000
		}
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/Weapon"
		//With = "&<drone_luncher.rules>/Weapon"
		With
		{
			Type = TurretWeapon
			Location = [1.5, 1.5]// Relative to upper-left corner of unrotated part.
			Rotation = -90d// Relative to unrotated part.
			OperationalToggle = OperationalWithPower
			AutoFireToggle = AutoFireToggle
			FirePermissionToggle = FireModeToggle
			TargetingArc = 360d
			TargetingRange = 300
			FiringArc = 360d
			//FiringArc = 0d; //fire forward
			//ValidArc = 360d; //aim in any direction
			RotateSpeed = 2080d
			FireThresholdAngle = 1d
			FireInterval = 2
			AIFirepowerRating = 400
			Emitter = BulletEmitter
			IgnoreFriendlyShipLowLOSChecks = true
			IgnoreFriendlyShipHighLOSChecks = true
			IgnoreJunkLOSChecks = true
			ReturnToCenter = false
			CanBeGivenExplicitTarget = true
			AllowDirectControl = true
			//AllowFireWithBlockedLOS = true
			//HoldTargetAfterCancel = "<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/Components/BulletEmitter/FireDelay"
			HoldTargetAfterCancel = 1
			AutoTargetCrewSafetyDist = 8

			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]

		}
	}
	

	
	
	{
		Action = RemoveMany
		RemoveMany = 
		[
			// Unused Stats
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats/BaseDamage"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats/HitInterval"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats/Duration"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats/ROF"
			"<../../../workshop/content/799600/2995534359/parts/arc_emitter/arc_emitter.rules>/Part/StatsByCategory/0/Stats/Range"
		]
	}
	
	
// Rebalance Arc Transformer
	// Reduced cost
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Resources"
		With
		[
			[steel, 36]
			[coil2, 22]
			[processor, 1]
		]
	}
	// Reduced maximum power stored
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/BatteryStorage/MaxResources"
		IgnoreIfNotExisting = false
		With = 12000
	}
	// Reduced maximum arc energy stored
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/TransformerArcEnergyStorage/MaxResources"
		IgnoreIfNotExisting = false
		With = 4000
	}
	// Increased interval for arc energy production and increased arc energy production
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/ConvertFromBatteryToArcEnergy"
		IgnoreIfNotExisting = false
		Overrides
		{
			Interval = 1.5
			ToQuantity = 1000
		}
	}
	// Increased energy spent
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/ConvertFromBatteryToArcEnergy/From/0"
		IgnoreIfNotExisting = false
		Overrides
		{
			Quantity = 2000
			MinQuantityForConversion = 2000
		}
	}
	// Changed battery graphics
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/BatterySprites/ResourceLevels"
		IgnoreIfNotExisting = false
		With = &<parts/arc_transformer/arc_transformer.rules>/Part/Components/BatterySprites/ResourceLevels
	}
	// Changed arc energy graphics
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/ArcEnergySprites/ResourceLevels"
		IgnoreIfNotExisting = false
		With = &<parts/arc_transformer/arc_transformer.rules>/Part/Components/ArcEnergySprites/ResourceLevels
	}
	// Added crew requirement
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components/IsOperational/Toggles"
		With = [PowerToggle, BatteryStorage, PartCrew]
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Components"
		Overrides = &<parts/arc_transformer/arc_transformer.rules>/Part/Components/Crew
	}
	// New Stats
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Stats"
		CreateIfNotExisting = true
		Overrides
		{
			ArcEnergyGeneration = 1000 / 1000 / 1.5 // References didn't work
			ArcEnergyCapacity = 4000 / 1000 // References didn't work
			PowerUsageContinuous = 2000 / 1000 / 1.5 // References didn't work
			ArcEnergyConversionRate = [2000 / 1000, 1000 / 1000] // References didn't work
		}
	}
	// Remove
	{
		Action = RemoveMany
		RemoveMany = 
		[
			// Unused stats
//			"<../../../workshop/content/799600/2995534359/stats/stats.rules>/Stats/1"
//			"<../../../workshop/content/799600/2995534359/stats/stats.rules>/Stats/2"
			"<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Stats/ArcEnergyConversionRate"
			"<../../../workshop/content/799600/2995534359/parts/arc_transformer/arc_transformer.rules>/Part/Stats/ArcEnergyConversionTime"
		]
	}

// Rebalance Galvanic Armor
	// Reduced cost
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Resources"
		With
		[
			[steel, 24]
			[coil2, 8]
			[tristeel, 10]
		]
	}
	// Reduced penetration resistance and explosive resistance
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part"
		IgnoreIfNotExisting = false
		Overrides
		{
			InitialPenetrationResistance = 5
			ExplosiveDamageResistance = 50%
		}
	}
	// Reduced shared arc energy value
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/ArcEmitterStorageProxy/ProvidedValuePerResource"
		IgnoreIfNotExisting = false
		With = 1/2000
	}
	// Increased energy production interval and energy production
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/ConvertFromArcEnergyToBatter"
		IgnoreIfNotExisting = false
		Overrides
		{
			Interval = 1.5
			ToQuantity = 4000
		}
	}
	// Increased fire rate
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/FireTimer/Duration"
		IgnoreIfNotExisting = false
		With = 1/30
	}
	// Increased search per second
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/TurretProxy/TargetSearchesPerSecond"
		IgnoreIfNotExisting = false
		With = 15
	}
	// Replaced bullets with beams, increased power spent and modified their values
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterLeft"
		IgnoreIfNotExisting = false
		Overrides
		{
			BulletEmitterLeft : "<shots/galvanic_bolt/galvanic_bolt.rules>"
			{
				Type = BeamEmitter
				ResourcesUsed = 40
			}
		}
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/BulletEmitterRight"
		IgnoreIfNotExisting = false
		Overrides
		{
			BulletEmitterRight : "<shots/galvanic_bolt/galvanic_bolt.rules>"
			{
				Type = BeamEmitter
				ResourcesUsed = 40
			}
		}
	}
	// Add targeting and preferred fire
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/TurretProxy"
		IgnoreIfNotExisting = false
		Overrides = &<parts/galvanic_armor/galvanic_armor.rules>/Part/Components/TurretProxy
	}
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components"
		IgnoreIfNotExisting = false
		Overrides = &<parts/galvanic_armor/galvanic_armor.rules>/Part/Components/FirePref
	}
	// New stats
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats"
		CreateIfNotExisting = true
		Overrides
		{
			DamageContinuousNear = 50 / (1/30) // References didn't work
			DamageContinuousFar = 25 / (1/30) // References didn't work
			ShotContinuousDamageNear = 250 / (1/30) // References didn't work
			ShotContinuousDamageFar = 125 / (1/30) // References didn't work
			PowerUsageContinuous = 0.025 / (1/30) // References didn't work
		}
	}
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Stats/RecPower"
		With = 0.025 / (1/30) // References didn't work
	}
	// Remove
	{
		Action = RemoveMany
		RemoveMany = 
		[
			// Unused stats
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/DamagePerShot"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/DamagePerSecond"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/DamagePerShotNear"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/DamagePerShotFar"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/DamageContinuousNear"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/DamageContinuousFar"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/ROF"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/ShotDamagePerShot"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/ShotDamagePerSecond"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/ShotDamage"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/ShotPowerUsage"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/PowerPerShot"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/PowerPerSecond"
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/StatsByCategory/0/Stats/HitInterval"
			// To add targeting
			"<../../../workshop/content/799600/2995534359/parts/galvanic_armor/galvanic_armor.rules>/Part/Components/FireModeToggle/AvailableChoices"
		]
	}

// Rebalance Heavy Ion Blaster
	// Reduced cost
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/Resources"
		With
		[
			[steel, 80]
			[coil, 14]
			[coil2, 22]
		]
	}
	// Reduced resource used
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/Components/BulletEmitter"
		IgnoreIfNotExisting = false
		Overrides
		{
			ResourcesUsed = 5000
			MinResourcesUsed = 5000
		}
	}	
	// Reduced projectile HP
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/Components/Targetable/Health"
		IgnoreIfNotExisting = false
		With = 3000
	}
	// Reduced impact
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/Components/Hit/HitStructural/HitEffects/1/Impulse"
		IgnoreIfNotExisting = false
		With = 25
	}
	// Increased fire rate
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/parts/heavy_ion_blaster/heavy_ion_blaster.rules>/Part/Components/Turret/FireInterval"
		IgnoreIfNotExisting = false
		With = 2.5
	}
	// Corrected arc spawn of scatter
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/heavy_ion_blaster_shot.rules>/Components/Hit/HitOperational/HitEffects/2/Arc"
		With = [-60d, 120d] // [-45d, 90d]
	}
	// Reduced projectile scatter lifetime
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/ion_scatter_ray.rules>/Components/DeployDeath/Lifetime"
		IgnoreIfNotExisting = false
		With = [0.4, 1.2]
	}
	// Added penetration, reduced damage and impulse, added effect on HitShield
	/* Didn't work, no idea why	
	{
		Action = Replace
		Replace = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/ion_scatter_ray.rules>/Components/Hit"
		IgnoreIfNotExisting = false
		With = &<shots/heavy_ion_blaster/ion_scatter_ray.rules>/Components/Hit
	}*/
		
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/ion_scatter_ray.rules>/Components"
		Overrides
		{
			Hit
			{
				Type = PenetratingHit
				Penetration = 10000 // 21
				PenetratesShields = false
				PenetrationSpeed = 5

				CrewCollisions = {Enemies=true; Junk=true}
				PenetratesCrew = true
				HitCrew = &HitOperational

				HitShield = &HitOperational
				HitOperational
				{
					ReduceEffectsByPenetration = false
					Offset = [-0.15, 0]

					HitEffects
					[
						{
							Type = Damage
							Damage = 250 
						}
						{
							Type = Fire
							FireChance = .2
						}
						{
							Type = AreaCrewStun
							Duration = 0.5
							Falloff = 1
							Radius = 1
							Cumulative = true
							HitShipOnly = true
						}
					]

					/*MediaEffects : "&<./Data/../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/ion_burst.rules>/Components/Hit/HitOperational/MediaEffects"
					[
					]*/

				}
				HitStructural
				{
					ReduceEffectsByPenetration = false
					Offset = [0.15, 0]

					HitEffects
					[
						{
							Type = Damage
							Damage = 125
						}
					]

					/*MediaEffects : "&<./Data/../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/ion_burst.rules>/Components/Hit/HitOperational/MediaEffects"
					[
					]*/
				}
				PenetratingOperational = &HitOperational
				PenetratingStructural
				{
					// No effect.
				}
				FinishedPenetratingOperational = &PenetratingOperational
				FinishedPenetratingStructural = &PenetratingStructural
			}
		}
	}
	// New Stats
	{
		Action = Add
