// Rebalance Cluster Missile
	// Increase base damage and radius
	{
		Action = Overrides
		OverrideIn = "<../../../workshop/content/799600/2995534359/shots/missile_cluster/missile_cluster_stage1.rules>/Components/Hit/HitOperational/HitEffects/0"
		IgnoreIfNotExisting = false
		Overrides
		{
			TotalDamage = 12000
			Radius = 3
		}
	}
	// Reduce damage of the cluster missiles
	// The first action is to prevent it from crashing
	{
		Action = Replace
		Replace = "&<../../../workshop/content/799600/2995534359/shots/missile_cluster/missile_cluster_stage2.rules>/Components/Targetable/OnDeath"
		With = "&<./Data/../../../workshop/content/799600/2995534359/shots/missile_cluster/missile_cluster_stage1.rules>/Components/Hit/HitFriendly"
	}
	// Do this in a file???
	{
		Action = Overrides
		OverrideIn = "&<../../../workshop/content/799600/2995534359/shots/missile_cluster/missile_cluster_stage2.rules>/Components"
		IgnoreIfNotExisting = false
		CreateIfNotExisting = true
		Overrides
		{
			Hit : "&<./Data/../../../workshop/content/799600/2995534359/shots/missile_cluster/missile_cluster_stage1.rules>/Components/Hit"
			{
				HitOperational : "&<./Data/../../../workshop/content/799600/2995534359/shots/missile_cluster/missile_cluster_stage1.rules>/Components/Hit/HitOperational"
				{
					HitEffects : "&<./Data/../../../workshop/content/799600/2995534359/shots/missile_cluster/missile_cluster_stage1.rules>/Components/Hit/HitOperational/HitEffects"
					[
						{
							Type = ExplosiveDamage
							TotalDamage = 4000
							Radius = 1
						}
					]
				}
			}
		}
	}
