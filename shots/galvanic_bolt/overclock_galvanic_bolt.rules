OVERCLOCK
{
	RANGE = 60
	RADIUS = 3
}

BASE = &<galvanic_bolt.rules>

Range = &~/OVERCLOCK/RANGE
HitEffectsScaleOverRange = [1, 0.5]
ClipRangeToTarget = true

BeamMediaEffects :	~/BASE/BeamMediaEffects
[

]

HitCrew = &HitNothing

HitShield = &HitNothing

HitOperational = &HitNothing

HitStructural = &HitNothing

HitBullet = &HitNothing

HitNothing // : &<./Data/../../../workshop/content/799600/2995534359/shots/galvanic_bolt/galvanic_bolt.rules>/Components/Hit/HitBullet
{
	HitEffects
	[
		{
			Type = ExplosiveDamage
			DamageType = default
			TotalDamage = { BaseValue = &<./Data/../../../workshop/content/799600/2995534359/shots/galvanic_bolt/galvanic_bolt.rules>/Components/Hit/HitBullet/HitEffects/0/Damage; BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent = 1 }
			Radius = &~/OVERCLOCK/RADIUS
            Slices = 1
			Filter
			{
				Ships = false
				Shields = false
				Bullets = true
				OnlyBulletCategories = [missile, laser, bullet, mine]
				Crew = true
			}
		}
		{
			Type = ExplosiveDamage
			DamageType = default
			TotalDamage = { BaseValue = &<./Data/../../../workshop/content/799600/2995534359/shots/galvanic_bolt/galvanic_bolt.rules>/Components/Hit/HitOperational/HitEffects/0/Damage; BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent = 1 }
			Radius = &~/OVERCLOCK/RADIUS
			Slices = 1
			Filter
			{
				Ships = true
				Shields = true
				Bullets = false
				Crew = false
			}
		}
	]

	MediaEffects // : &<./Data/../../../workshop/content/799600/2995534359/shots/galvanic_bolt/galvanic_bolt.rules>/Components/Hit/HitOperational/MediaEffects
	[
		&<./Data/../../../workshop/content/799600/2995534359/shots/galvanic_bolt/particles/galvanic_bolt_hit.rules>
		&<./Data/../../../workshop/content/799600/2995534359/shots/galvanic_bolt/particles/galvanic_bolt_hit_sparks.rules>
		&<./Data/../../../workshop/content/799600/2995534359/shots/galvanic_bolt/particles/galvanic_bolt_hit_light.rules>
	]
}