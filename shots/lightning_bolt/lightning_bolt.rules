Volumen = 2

OVERCLOCK
{
	MAX_CHAIN_LENGTH_BONUS = 1
	RADIUS_FACTOR = 2/1.5
	RANGE_FACTOR = 4/2.5
}

MAX_CHAIN_LENGTH_1_MODIFIERS
[
	{
		Type = BuffRemap
		BuffType = Overclock
		ModificationMode = Add
		RemapFrom = [0, 1]
		RemapTo = [0, (&~/OVERCLOCK/MAX_CHAIN_LENGTH_BONUS)]
	}
]

RANGE_MODIFIERS
[
	{
		Type = BuffRemap
		BuffType = Overclock
		ModificationMode = Add
		RemapFrom = [0, 1]
		RemapTo = [0, (&~/OVERCLOCK/RANGE_FACTOR)]
	}
]

Base
{
	Range = {BaseValue = 250, Modifiers = &~/MAX_CHAIN_LENGTH_1_MODIFIERS}
	IdealRange = {BaseValue = 150, Modifiers = &~/MAX_CHAIN_LENGTH_1_MODIFIERS}
}

HitEffects
[
	{
		Type = ChainLightning
		MaxChainLength = [{BaseValue = 3, Modifiers = &~/MAX_CHAIN_LENGTH_1_MODIFIERS}, {BaseValue = 3, Modifiers = &~/MAX_CHAIN_LENGTH_1_MODIFIERS}]
		InitialRadius
		{
			BaseValue = 1.5
			Modifiers
			[
				{
					Type = BuffRemap
					BuffType = Overclock
					ModificationMode = Multiply
					RemapFrom = [0, 1]
					RemapTo = [1, (&~/OVERCLOCK/RADIUS_FACTOR)]
				}
			]
		}
		ChainRadius = &InitialRadius
		InitialChance = 100%
		InitialStrikes = [1, 1]
		InitialStrikeRandomOffsetRadius = 0
		RaycastInitialTargets = true
		ChainChance = 100%
		ChainStrikes = [1, 2]
		MaxInitialAngle = 360d
		MaxChainAngle = 60d
		ChainDelay = 0.02
		ChainEffectFalloff = 0.5
		HitEffects
		[
			{
				Type = Damage
				Damage
				{
					BaseValue = 250
					Modifiers
					[
						{
							Type = Buff
							BuffType = Arc_Emitter_Shot	// Only when Overclocked
							ModificationMode = Multiply
						}
						{
							Type = Buff
							BuffType = ElectronBuff
							ModificationMode = Multiply
						}
						{
							Type = EffectScale
							ModificationMode = Multiply
						}
					]
				}
				Filter
				{
					Self = true
				}
			}
		]
		MediaEffects
		[
			&<particles/lightning_bolt_overclock_lightning_hit.rules>
			&<particles/lightning_bolt_overclock_flash.rules>
			&<particles/lightning_bolt_hit_sparks.rules>
		]
		ChainMediaEffects
		[
			&<particles/lightning_bolt_overclock_lightning_chain.rules>
			&<particles/lightning_bolt_overclock_flash.rules>
			&<particles/lightning_bolt_hit_sparks.rules>
		]
		HitFilter
		{
			Self = true
			Friendlies = true
			Enemies = true
			Neutrals = true
			Junk = true
		
			Ships = true
			OperationalHealth = true
			StructuralHealth = true
			Shields = true
			Bullets = true
			Crew = true
			Nuggets = true
			IgnoreInvulnerability = true
		}
	}
]