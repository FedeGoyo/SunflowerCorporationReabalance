Physics_Radius = 0.1	// Increase size
Targetable_Health = 300	// Increase projectile HP

Base
{
	Range = 300	// Increase range
	IdealRange = [200, 300]
	ReceivableBuffs = [ElectronBuff]
	
}

HitOperational
{
	HitEffects	// Removed damage
	[
		{
			Type = Impulse
			Impulse = { BaseValue = 16; EffectScaleExponent = 1 }	// Increase impulse and add EffectScaleExponent
		}
		{
			Type = SpawnBullets
			Bullet = &<ion_scatter_ray.rules>
			Count = 5
			Arc = [-45d, 90d]
			Spread = [-5d, 10d]
			InheritVelocity = false
			ScaleHealth = false
		}
	]
}

HitStructural
{
	HitEffects
	[
		{
			Type = Damage
			Damage = { BaseValue=150; BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent = 1 }
		}
		{
			Type = Impulse
			Impulse = { BaseValue = 8; EffectScaleExponent = 1 }	// Increase impulse and add EffectScaleExponent
		}
	]
}

PenetratingStructural : &HitStructural
{
	StructuralDamageRetentionPerHit = &<./Data/cosmoteer.rules>/STRUCTURAL_DAMAGE_RETENTION_PER_HIT
	MinStructuralDamageScale = &<./Data/cosmoteer.rules>/MIN_STRUCTURAL_DAMAGE_SCALE
}