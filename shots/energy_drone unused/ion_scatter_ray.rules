ID = "enderluck.ion_scatter_ray"
Range = 300
IdealRange = [200, 300]
IdealRadius = 180
Speed = 5
Explosion = &<../../shots/energy_drone/ion_burst.rules>

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.1
		Density = 0.0001
	}

	Targetable
	{
		Type = Targetable
		Health = 5000
		TargetCategory = "laser"
	}

	DeployDeath
	{
		Type = DeathByLifetime
		Lifetime = [0.5, 1.5]

		OnDeath
		{
			HitEffects
			[
				{
					Type = SpawnBullets
					Bullet = &~/Explosion
					Count = 1
					InheritVelocity = false
					ScaleHealth = false
				}
			]
		}
	}

	DeathByDistanceTraveled
	{
		Type = DeathByDistanceTraveled
		// Distance auto-computed from range.
		HasTarget = false
	}
	DeathByDistanceTraveledTargeted
	{
		Type = DeathByDistanceTraveled
		Distance = (&~/Range) * 3
		HasTarget = true
	}
	
	Hit
	{
		Type = SimpleHit
		FriendlyShipLowCollisions = false
		FriendlyShipHighCollisions = false
		NonFriendlyShipLowCollisions = false
		NonFriendlyShipHighCollisions = false
		
		HitShield
		{
			HitEffects
			[
				// Do nothing. Shields kill this effect.
			]
		}
	}

	MediaEffects
	{
		Type = MediaEffects
		MediaEffects
		[
			&<particles/ion_scatter_lightning.rules>
		]
	}
}