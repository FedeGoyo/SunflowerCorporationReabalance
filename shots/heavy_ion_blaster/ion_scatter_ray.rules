Base
{
	ReceivableBuffs = [ElectronBuff]
}

DeployDeath_Lifetime = [0.4, 1.2]	// Reduce projectile scatter lifetime

Hit	// Add penetration
{
	Type = PenetratingHit
	Penetration = infinity
	PenetratesShields = false
	PenetrationSpeed = 5

	CrewCollisions = {Enemies=true; Junk=true}
	PenetratesCrew = true
	HitCrew = &HitOperational

	HitShield = &HitOperational
	HitOperational
	{
		ReduceEffectsByPenetration = false
		Offset = [-0.15, 0]

		HitEffects
		[
			{
				Type = Damage
				Damage =  { BaseValue=250; BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent = 1 }
			}
			{
				Type = StatusApplication
				StatusType = cosmoteer.fire
				StatusChance = { BaseValue = .1; EffectScaleExponent = 1 }
				ValueType = Interpolated
			}
			{
				Type = AreaCrewStun
				Duration = { BaseValue = .5; EffectScaleExponent = 1 }
				Falloff = 1
				Radius = 1
				Cumulative = false
				HitShipOnly = true
			}
		]

		/*MediaEffects : "&<./Data/../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/ion_burst.rules>/Components/Hit/HitOperational/MediaEffects"
		[
		]*/

	}
	HitStructural
	{
		ReduceEffectsByPenetration = false
		Offset = [0.15, 0]

		HitEffects
		[
			{
				Type = Damage
				Damage = { BaseValue=125; BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent = 1 }
			}
		]

		/*MediaEffects : "&<./Data/../../../workshop/content/799600/2995534359/shots/heavy_ion_blaster/ion_burst.rules>/Components/Hit/HitOperational/MediaEffects"
		[
		]*/
	}
	PenetratingOperational = &HitOperational
	PenetratingStructural : &HitStructural
	{
		StructuralDamageRetentionPerHit = &/STRUCTURAL_DAMAGE_RETENTION_PER_HIT
		MinStructuralDamageScale = &/MIN_STRUCTURAL_DAMAGE_SCALE
	}
	FinishedPenetratingOperational = &PenetratingOperational
	FinishedPenetratingStructural = &PenetratingStructural
}